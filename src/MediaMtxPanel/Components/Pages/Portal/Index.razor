@page "/portal"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject StreamService Streams
@inject LiveStatusReader LiveReader

<AppPageTitle Text="@L["My streams"]" />

<div class="page-header">
    <div>
        <h1><i class="bi bi-collection-play text-primary"></i> @L["My streams"]</h1>
        <p class="page-subtitle">@L["Open a stream to see the preview, get the settings for your broadcast software, share the watch page or sell tickets."]</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-primary" href="portal/payments"><i class="bi bi-credit-card"></i> @L["Payment settings"]</a>
    </div>
</div>

@if (streams is null)
{
    <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>@L["Loading…"]</p>
}
else if (streams.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-camera-video-off"></i>
        <p class="mb-1">@L["No streams are linked to your account yet."]</p>
        <p class="mb-0 small">@L["Contact your administrator to have a stream created."]</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var s in streams)
        {
            var p = live.Find(s);
            <div class="col-md-6 col-xl-4">
                <div class="card entity-card h-100 position-relative">
                    <div class="card-body">
                        <div class="entity-head">
                            <span class="avatar"><i class="bi @(p?.IsLive == true ? "bi-broadcast" : "bi-camera-video")"></i></span>
                            <div class="flex-grow-1" style="min-width:0">
                                <div class="entity-title">@s.DisplayName</div>
                                <div class="entity-sub">@s.Server!.PublicHost · <code>@s.Name</code></div>
                            </div>
                        </div>
                        <div class="entity-meta">
                            <StreamStateBadge Stream="s" Live="p" />
                            <span class="badge text-bg-light border"><i class="bi bi-eye me-1"></i>@L["{0} viewer(s)", p?.Readers.Count ?? 0]</span>
                            @if (s.PaywallEnabled)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis"><i class="bi bi-ticket-perforated me-1"></i>@L["Paywall on"]</span>
                            }
                            else if (s.PublicRead)
                            {
                                <span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-globe2 me-1"></i>@L["Public"]</span>
                            }
                        </div>
                        <div class="entity-actions">
                            <span class="btn btn-sm btn-outline-primary"><i class="bi bi-box-arrow-in-right"></i> @L["Open"]</span>
                        </div>
                        <a class="stretched-link" href="portal/streams/@s.Id" aria-label="@L["Open"] @s.DisplayName"></a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<StreamDefinition>? streams;
    private LiveSnapshot live = new();
    private readonly CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        streams = await Streams.ListAsync((await AuthState).User);
        await RefreshAsync();
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshAsync() =>
        live = await LiveReader.ReadAsync(streams!.Select(s => s.Server!), includeInfo: false, cts.Token);

    public ValueTask DisposeAsync()
    {
        cts.Cancel();
        cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
