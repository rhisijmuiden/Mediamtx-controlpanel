@page "/portal"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject StreamService Streams
@inject LiveStatusReader LiveReader

<PageTitle>My streams</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">My streams</h1>
    <a class="btn btn-outline-primary" href="portal/payments">Payment settings</a>
</div>

@if (streams is null)
{
    <p>Loading…</p>
}
else if (streams.Count == 0)
{
    <div class="text-center text-secondary py-5">
        <p>No streams are linked to your account yet.</p>
        <p>Contact your administrator to have a stream created.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var s in streams)
        {
            var p = live.Find(s);
            <div class="col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h2 class="h5 mb-0">@s.DisplayName</h2>
                            <StreamStateBadge Stream="s" Live="p" />
                        </div>
                        <div class="small text-secondary mb-2">@s.Server!.PublicHost · <code>@s.Name</code></div>
                        <div class="small">
                            @(p?.Readers.Count ?? 0) viewer(s)
                            @if (s.PaywallEnabled)
                            {
                                <span class="badge text-bg-warning ms-2">Paywall on</span>
                            }
                            else if (s.PublicRead)
                            {
                                <span class="badge text-bg-info ms-2">Public</span>
                            }
                        </div>
                        <a class="stretched-link" href="portal/streams/@s.Id"></a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<StreamDefinition>? streams;
    private LiveSnapshot live = new();
    private readonly CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        streams = await Streams.ListAsync((await AuthState).User);
        await RefreshAsync();
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshAsync() =>
        live = await LiveReader.ReadAsync(streams!.Select(s => s.Server!), includeInfo: false, cts.Token);

    public ValueTask DisposeAsync()
    {
        cts.Cancel();
        cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
