@page "/portal/payments"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PaywallService Paywall

<AppPageTitle Text="@L["Payment settings"]" />

<a class="back-link" href="portal"><i class="bi bi-arrow-left"></i> @L["My streams"]</a>

<div class="page-header">
    <div>
        <h1><i class="bi bi-credit-card text-primary"></i> @L["Payment settings"]</h1>
        <p class="page-subtitle">
            @L["Viewers pay for your streams through these accounts; the money goes straight to you."]
            @L["Keys and passwords are stored encrypted and are not shown here again."]
        </p>
    </div>
</div>

@if (message is not null)
{
    <div class="alert alert-success d-flex align-items-center gap-2"><i class="bi bi-check-circle"></i> <span>@message</span></div>
}

@if (input is null)
{
    <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>@L["Loading…"]</p>
}
else
{
    <EditForm Model="input" OnValidSubmit="Save" FormName="payments">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="action-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="action-icon info"><i class="bi bi-bank"></i></div>
                        <div class="form-check form-switch mb-0">
                            <InputCheckbox class="form-check-input" id="mollie" @bind-Value="input.MollieEnabled" />
                            <label class="form-check-label" for="mollie">@L["On"]</label>
                        </div>
                    </div>
                    <h3>@L["iDEAL via Mollie"]</h3>
                    <p>@L["Dutch viewers pay with their own bank in a few clicks."]</p>
                    <ol class="small text-secondary ps-3">
                        <li>@L["Create an account at"] <a href="https://www.mollie.com/" target="_blank" rel="noopener">mollie.com</a> @L["and enable iDEAL."]</li>
                        <li>@L["Under Developers → API keys, copy the key"] (<code>test_…</code> @L["to try it out,"] <code>live_…</code> @L["for real payments"]).</li>
                    </ol>
                    <label class="form-label" for="molliekey">@L["API key"]</label>
                    <InputText id="molliekey" class="form-control font-monospace" @bind-Value="input.MollieApiKey"
                               placeholder="@(input.HasMollieKey ? "•••••••• " + L["(saved, leave empty to keep)"] : L["live_… or test_…"])" />
                    @if (input.HasMollieKey)
                    {
                        <div class="form-text"><i class="bi bi-shield-lock me-1"></i>@L["A key is saved."]</div>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="action-card">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="action-icon"><i class="bi bi-paypal"></i></div>
                        <div class="form-check form-switch mb-0">
                            <InputCheckbox class="form-check-input" id="paypal" @bind-Value="input.PayPalEnabled" />
                            <label class="form-check-label" for="paypal">@L["On"]</label>
                        </div>
                    </div>
                    <h3>PayPal</h3>
                    <p>@L["Viewers pay with their PayPal account or a credit card."]</p>
                    <ol class="small text-secondary ps-3">
                        <li>@L["Go to"] <a href="https://developer.paypal.com/dashboard/applications" target="_blank" rel="noopener">developer.paypal.com</a> @L["and create an app (REST API)."]</li>
                        <li>@L["Copy the Client ID and the Secret. Use the sandbox first to test."]</li>
                    </ol>
                    <label class="form-label" for="ppid">@L["Client ID"]</label>
                    <InputText id="ppid" class="form-control font-monospace mb-2" @bind-Value="input.PayPalClientId" />
                    <label class="form-label" for="ppsecret">@L["Secret"]</label>
                    <InputText id="ppsecret" class="form-control font-monospace mb-2" @bind-Value="input.PayPalSecret"
                               placeholder="@(input.HasPayPalSecret ? "•••••••• " + L["(saved, leave empty to keep)"] : "")" />
                    <div class="form-check form-switch">
                        <InputCheckbox class="form-check-input" id="sandbox" @bind-Value="input.PayPalSandbox" />
                        <label class="form-check-label" for="sandbox">@L["Sandbox (test environment, no real money)"]</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-4 d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> @L["Save"]</button>
            <a href="portal" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> @L["Back"]</a>
        </div>
    </EditForm>
    @if (Paywall.TestPaymentsEnabled)
    {
        <div class="alert alert-info d-flex gap-2 small mt-4 mb-0">
            <i class="bi bi-info-circle"></i>
            <span>@L["Test payments are enabled on this server: viewers can also get a ticket with a simulated payment."]</span>
        </div>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private PaymentAccountInput? input;
    private string userId = "";
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        userId = StreamService.UserId((await AuthState).User)!;
        input = await Paywall.GetAccountInputAsync(userId);
    }

    private async Task Save()
    {
        await Paywall.SaveAccountAsync(userId, input!);
        input = await Paywall.GetAccountInputAsync(userId);
        message = L["Saved."];
    }
}
