@page "/portal/payments"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PaywallService Paywall

<PageTitle>Payment settings</PageTitle>

<h1>Payment settings</h1>
<p class="text-secondary">
    Viewers pay for your streams through these accounts; the money goes straight to you.
    Keys and passwords are stored encrypted and are not shown here again.
</p>

@if (message is not null)
{
    <div class="alert alert-success">@message</div>
}

@if (input is not null)
{
    <EditForm Model="input" OnValidSubmit="Save" FormName="payments">
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>iDEAL via Mollie</strong>
                        <div class="form-check form-switch mb-0">
                            <InputCheckbox class="form-check-input" id="mollie" @bind-Value="input.MollieEnabled" />
                            <label class="form-check-label" for="mollie">On</label>
                        </div>
                    </div>
                    <div class="card-body">
                        <ol class="small ps-3">
                            <li>Create an account at <a href="https://www.mollie.com/" target="_blank" rel="noopener">mollie.com</a> and enable iDEAL.</li>
                            <li>Under <em>Developers → API keys</em>, copy the key (<code>test_…</code> to try it out, <code>live_…</code> for real payments).</li>
                        </ol>
                        <label class="form-label" for="molliekey">API key</label>
                        <InputText id="molliekey" class="form-control font-monospace" @bind-Value="input.MollieApiKey"
                                   placeholder="@(input.HasMollieKey ? "•••••••• (saved, leave empty to keep)" : "live_… or test_…")" />
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>PayPal</strong>
                        <div class="form-check form-switch mb-0">
                            <InputCheckbox class="form-check-input" id="paypal" @bind-Value="input.PayPalEnabled" />
                            <label class="form-check-label" for="paypal">On</label>
                        </div>
                    </div>
                    <div class="card-body">
                        <ol class="small ps-3">
                            <li>Go to <a href="https://developer.paypal.com/dashboard/applications" target="_blank" rel="noopener">developer.paypal.com</a> and create an app (REST API).</li>
                            <li>Copy the <em>Client ID</em> and the <em>Secret</em>. Use the sandbox first to test.</li>
                        </ol>
                        <label class="form-label" for="ppid">Client ID</label>
                        <InputText id="ppid" class="form-control font-monospace mb-2" @bind-Value="input.PayPalClientId" />
                        <label class="form-label" for="ppsecret">Secret</label>
                        <InputText id="ppsecret" class="form-control font-monospace mb-2" @bind-Value="input.PayPalSecret"
                                   placeholder="@(input.HasPayPalSecret ? "•••••••• (saved, leave empty to keep)" : "")" />
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" id="sandbox" @bind-Value="input.PayPalSandbox" />
                            <label class="form-check-label" for="sandbox">Sandbox (test environment, no real money)</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="portal" class="btn btn-outline-secondary">Back</a>
        </div>
    </EditForm>
    @if (Paywall.TestPaymentsEnabled)
    {
        <p class="small text-secondary mt-3">Test payments are enabled on this server: viewers can also get a ticket with a simulated payment.</p>
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private PaymentAccountInput? input;
    private string userId = "";
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        userId = StreamService.UserId((await AuthState).User)!;
        input = await Paywall.GetAccountInputAsync(userId);
    }

    private async Task Save()
    {
        await Paywall.SaveAccountAsync(userId, input!);
        input = await Paywall.GetAccountInputAsync(userId);
        message = "Saved.";
    }
}
