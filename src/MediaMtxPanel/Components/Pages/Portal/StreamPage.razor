@page "/portal/streams/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject StreamService Streams
@inject PaywallService Paywall
@inject StreamEndpointBuilder Endpoints
@inject NavigationManager Nav

<AppPageTitle Text="@(stream?.DisplayName ?? L["Stream"])" />

<a class="back-link" href="portal"><i class="bi bi-arrow-left"></i> @L["My streams"]</a>

@if (notFound)
{
    <div class="empty-state">
        <i class="bi bi-camera-video-off"></i>
        <p class="mb-3">@L["Stream not found"]</p>
        <a class="btn btn-outline-secondary" href="portal"><i class="bi bi-arrow-left"></i> @L["Back to my streams"]</a>
    </div>
}
else if (stream is null)
{
    <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>@L["Loading…"]</p>
}
else
{
    <div class="page-header mb-3">
        <div>
            <h1 class="flex-wrap">
                <i class="bi bi-camera-video text-primary"></i> @stream.DisplayName
                <span class="fs-6"><StreamStateBadge Stream="stream" Live="live" /></span>
                @if (stream.PaywallEnabled)
                {
                    <span class="badge bg-warning-subtle text-warning-emphasis fs-6"><i class="bi bi-ticket-perforated me-1"></i>@L["Paywall on"]</span>
                }
                else if (stream.PublicRead)
                {
                    <span class="badge bg-info-subtle text-info-emphasis fs-6"><i class="bi bi-globe2 me-1"></i>@L["Public"]</span>
                }
            </h1>
            <p class="page-subtitle">@stream.Server!.PublicHost · <code>@stream.Name</code></p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-primary" href="@WatchUrl" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> @L["Open watch page"]</a>
        </div>
    </div>

    <div class="mb-4">
        <StatsBar Stream="stream" OnLive="OnLive" />
    </div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="card">
                <div class="card-header"><i class="bi bi-play-circle"></i> @L["Preview"]</div>
                <div class="card-body">
                    <StreamPlayer Stream="stream" User="@stream.ReadUser" Pass="@stream.ReadPassword" />
                    <div class="d-flex gap-2 small text-secondary mt-3">
                        @if (live?.IsLive == true)
                        {
                            <i class="bi bi-check-circle text-success"></i>
                            <span>@L["Your stream is coming in. If you see video above, your viewers see it too."]</span>
                        }
                        else if (stream.SourceType == StreamSourceType.Publisher)
                        {
                            <i class="bi bi-hourglass-split"></i>
                            <span>@L["No video yet. Start your broadcast with the details under Connect; the preview starts automatically."]</span>
                        }
                        else
                        {
                            <i class="bi bi-hourglass-split"></i>
                            <span>@(stream.SourceOnDemand ? L["No video yet. The server pulls the source as soon as someone watches."] : L["No video yet. The server pulls the source as soon as it is reachable."])</span>
                        }
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header"><i class="bi bi-info-circle"></i> @L["Details"]</div>
                <div class="card-body">
                    <dl class="info-list">
                        <dt>@L["Server"]</dt><dd>@stream.Server!.Name (@stream.Server.PublicHost)</dd>
                        <dt>@L["Path"]</dt><dd><code>@stream.Name</code></dd>
                        <dt>@L["Type"]</dt><dd>@(stream.SourceType == StreamSourceType.Publisher ? L["You broadcast it yourself"] : L["The server pulls a source"])</dd>
                        <dt>@L["Status"]</dt><dd>@(stream.Enabled ? L["Enabled"] : L["Disabled by the administrator"])</dd>
                        <dt>@L["Recording"]</dt><dd>@(stream.Record ? L["On"] : L["Off"])</dd>
                        @if (stream.MaxReaders > 0)
                        {
                            <dt>@L["Max. viewers"]</dt><dd>@stream.MaxReaders</dd>
                        }
                        @if (!string.IsNullOrEmpty(stream.Description))
                        {
                            <dt>@L["Description"]</dt><dd>@stream.Description</dd>
                        }
                    </dl>
                </div>
            </div>

            <div class="mt-4">
                <RecordingList Stream="stream" ShowServerHint="@isStaff" />
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card connect-panel">
                <div class="card-header pb-0">
                    <ul class="nav nav-tabs card-header-tabs">
                        @foreach (var (key, label, icon) in tabs)
                        {
                            <li class="nav-item">
                                <button type="button" class="nav-link @(tab == key ? "active" : "")" @onclick="() => tab = key"><i class="bi @icon me-1"></i>@L[label]</button>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-body">
                    @if (tab == "connect")
                    {
                        @if (stream.SourceType == StreamSourceType.Publisher)
                        {
                            <h6><i class="bi bi-display me-1 text-primary"></i> OBS Studio / Streamlabs / vMix</h6>
                            <p class="small text-secondary mb-2">@L["Settings → Stream → Service: Custom…"]</p>
                            <CopyField Label="@L["Server"]" Value="@obs!.Server" />
                            <CopyField Label="@L["Stream key"]" Value="@obs.StreamKey" Secret="true" />
                            <hr />
                            <h6><i class="bi bi-key me-1 text-primary"></i> @L["Credentials"]</h6>
                            <CopyField Label="@L["Username"]" Value="@stream.PublishUser" />
                            <CopyField Label="@L["Password"]" Value="@stream.PublishPassword" Secret="true" />
                            <hr />
                            <h6><i class="bi bi-diagram-3 me-1 text-primary"></i> @L["Other protocols"]</h6>
                            @foreach (var e in publish.Where(e => e.Protocol is not "WebRTC (browser)"))
                            {
                                <CopyField Label="@e.Protocol" Value="@e.Url" Secret="@e.HasCredentials" />
                                @if (e.Note is not null)
                                {
                                    <p class="small text-secondary mt-n2">@L[e.Note]</p>
                                }
                            }
                            <div class="alert alert-light border small d-flex gap-2 mb-0 mt-3">
                                <i class="bi bi-webcam"></i>
                                <span>
                                    @L["No software?"] <a href="@BrowserPublishUrl" target="_blank" rel="noopener">@L["Broadcast from your browser"]</a>
                                    @L["(webcam or screen, sign in with the credentials above)."]
                                </span>
                            </div>
                        }
                        else
                        {
                            <p class="small">@L["The server pulls this stream; you don't need to send anything yourself."]</p>
                            <CopyField Label="@L["Source"]" Value="@(stream.SourceUrl ?? "")" Secret="true" />
                        }
                    }
                    else if (tab == "share")
                    {
                        <h6><i class="bi bi-link-45deg me-1 text-primary"></i> @L["Watch page"]</h6>
                        <p class="small text-secondary mb-2">
                            @if (stream.PaywallEnabled)
                            {
                                <span>@L["Viewers buy a ticket here and then watch right away in the browser."]</span>
                            }
                            else if (stream.PublicRead)
                            {
                                <span>@L["Anyone with this link can watch."]</span>
                            }
                            else
                            {
                                <span>@L["This stream is private: turn on the paywall to sell tickets, or ask the administrator to make it public."]</span>
                            }
                        </p>
                        <CopyField Value="@WatchUrl" />
                        <a class="btn btn-sm btn-outline-primary mb-3" href="@WatchUrl" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> @L["Open watch page"]</a>
                        <hr />
                        <h6><i class="bi bi-key me-1 text-primary"></i> @L["Viewing credentials"]</h6>
                        <p class="small text-secondary mb-2">@L["For your own use or regular viewers, separate from the paywall."]</p>
                        <CopyField Label="@L["Username"]" Value="@stream.ReadUser" />
                        <CopyField Label="@L["Password"]" Value="@stream.ReadPassword" Secret="true" />
                        @foreach (var e in read.Where(e => e.Protocol is "HLS" or "RTSP" or "SRT"))
                        {
                            <CopyField Label="@e.Protocol" Value="@e.Url" Secret="@e.HasCredentials" />
                        }
                    }
                    else
                    {
                        @if (paywallMessage is not null)
                        {
                            <div class="alert alert-@(paywallMessageIsError ? "danger" : "success") small py-2 d-flex gap-2">
                                <i class="bi @(paywallMessageIsError ? "bi-exclamation-octagon" : "bi-check-circle")"></i> <span>@paywallMessage</span>
                            </div>
                        }
                        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                            <div>
                                <strong>@L["Paywall"]</strong>
                                <span class="badge @(stream.PaywallEnabled ? "bg-warning-subtle text-warning-emphasis" : "bg-secondary-subtle text-secondary-emphasis") badge-dot ms-1">@(stream.PaywallEnabled ? L["on"] : L["off"])</span>
                                <div class="small text-secondary">@L["Viewers pay for access."]</div>
                            </div>
                            <button id="paywall" class="btn btn-sm @(stream.PaywallEnabled ? "btn-outline-secondary" : "btn-warning")" @onclick="TogglePaywall">
                                <i class="bi @(stream.PaywallEnabled ? "bi-toggle-off" : "bi-toggle-on")"></i> @(stream.PaywallEnabled ? L["Turn off"] : L["Turn on"])
                            </button>
                        </div>
                        <p class="small text-secondary">
                            @L["Payment via {0}", providers.Count > 0 ? string.Join(", ", providers.Select(ProviderLabel)) : L["no payment method yet"]]
                            · <a href="portal/payments">@L["Payment settings"]</a>
                        </p>

                        <h6 class="mt-3"><i class="bi bi-tags me-1 text-primary"></i> @L["Offers"]</h6>
                        @if (offers.Count == 0)
                        {
                            <p class="small text-secondary">@L["No offers yet. Add a day ticket or a season pass, for example."]</p>
                        }
                        @foreach (var o in offers)
                        {
                            <div class="offer-card mb-2 @(o.Active ? "" : "opacity-50")">
                                <div class="d-flex justify-content-between gap-2">
                                    <strong>@o.Name</strong>
                                    <span class="fw-semibold">@Format.Money(o.PriceCents, o.Currency)</span>
                                </div>
                                <div class="small text-secondary"><i class="bi bi-clock me-1"></i>@L["Access {0}", Hours(o.AccessHours)]@(o.Active ? "" : " · " + L["inactive"])</div>
                                @if (!string.IsNullOrEmpty(o.Description))
                                {
                                    <div class="small">@o.Description</div>
                                }
                                <div class="mt-2 d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => EditOffer(o)"><i class="bi bi-pencil"></i> @L["Edit"]</button>
                                    <button class="btn btn-sm btn-outline-danger btn-icon" @onclick="() => DeleteOffer(o)" title="@L["Delete"]"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        }

                        @if (offerInput is null)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="NewOffer"><i class="bi bi-plus-lg"></i> @L["Add offer"]</button>
                        }
                        else
                        {
                            <EditForm Model="offerInput" OnValidSubmit="SaveOffer" FormName="offer" class="offer-card mb-2">
                                <LocalizedValidator />
                                <div class="mb-2">
                                    <label class="form-label small" for="offer-name">@L["Name"]</label>
                                    <InputText id="offer-name" class="form-control form-control-sm" @bind-Value="offerInput.Name" placeholder="@L["Day ticket, HD version, season pass…"]" />
                                    <ValidationMessage For="() => offerInput.Name" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small" for="offer-desc">@L["Description (optional)"]</label>
                                    <InputText id="offer-desc" class="form-control form-control-sm" @bind-Value="offerInput.Description" />
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label small" for="offer-price">@L["Price (€)"]</label>
                                        <InputNumber id="offer-price" class="form-control form-control-sm" @bind-Value="offerInput.Price" step="0.01" />
                                        <ValidationMessage For="() => offerInput.Price" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small" for="offer-hours">@L["Access (hours)"]</label>
                                        <InputNumber id="offer-hours" class="form-control form-control-sm" @bind-Value="offerInput.AccessHours" />
                                        <ValidationMessage For="() => offerInput.AccessHours" />
                                    </div>
                                </div>
                                <div class="form-check mb-2">
                                    <InputCheckbox id="offer-active" class="form-check-input" @bind-Value="offerInput.Active" />
                                    <label class="form-check-label small" for="offer-active">@L["For sale"]</label>
                                </div>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check-lg"></i> @L["Save"]</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => offerInput = null"><i class="bi bi-x-lg"></i> @L["Cancel"]</button>
                                </div>
                            </EditForm>
                        }

                        <h6 class="mt-4"><i class="bi bi-graph-up me-1 text-primary"></i> @L["Sales"]</h6>
                        @if (sales is not null)
                        {
                            <div class="row g-2 small mb-2 text-center">
                                <div class="col-4"><div class="border rounded-3 p-2 bg-light h-100"><div class="text-secondary">@L["Sold"]</div><strong class="fs-6">@sales.PaidCount</strong></div></div>
                                <div class="col-4"><div class="border rounded-3 p-2 bg-light h-100"><div class="text-secondary">@L["Revenue"]</div><strong class="fs-6">@Format.Money(sales.RevenueCents, "EUR")</strong></div></div>
                                <div class="col-4"><div class="border rounded-3 p-2 bg-light h-100"><div class="text-secondary">@L["Valid tickets"]</div><strong class="fs-6">@sales.ActiveTickets</strong></div></div>
                            </div>
                            @if (sales.Recent.Count > 0)
                            {
                                <table class="table table-sm small mb-0">
                                    <tbody>
                                        @foreach (var o in sales.Recent)
                                        {
                                            <tr>
                                                <td>@o.CreatedAt.ToLocalTime().ToString("dd-MM HH:mm")</td>
                                                <td>@o.OfferName<div class="text-secondary">@(o.BuyerEmail ?? ProviderLabel(o.Provider))</div></td>
                                                <td class="text-end">@Format.Money(o.AmountCents, o.Currency)<div>@StatusLabel(o.Status)</div></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <h2 class="h5 mt-5 mb-3"><i class="bi bi-bar-chart-line text-primary me-1"></i>@L["Statistics"]</h2>
    <StatsView Streams="[stream]" />
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private static readonly (string Key, string Label, string Icon)[] tabs =
        [("connect", "Connect", "bi-broadcast-pin"), ("share", "Share", "bi-share"), ("paywall", "Paywall", "bi-ticket-perforated")];

    private StreamDefinition? stream;
    private List<StreamEndpoint> publish = [];
    private List<StreamEndpoint> read = [];
    private ObsSettings? obs;
    private MtxPath? live;
    private bool notFound;
    private string tab = "connect";
    private bool isStaff;

    private List<StreamOffer> offers = [];
    private List<PaymentProvider> providers = [];
    private SalesSummary? sales;
    private OfferInput? offerInput;
    private int? editingOfferId;
    private string? paywallMessage;
    private bool paywallMessageIsError;

    private string WatchUrl => Nav.ToAbsoluteUri($"watch/{stream!.WatchSlug}").ToString();

    private string BrowserPublishUrl => publish.FirstOrDefault(e => e.Protocol == "WebRTC (browser)")?.Url ?? "";

    protected override async Task OnInitializedAsync()
    {
        isStaff = Roles.Staff.Split(',').Any((await AuthState).User.IsInRole);
        await LoadAsync();
        if (stream is not null)
            await LoadPaywallAsync();
    }

    private async Task LoadAsync()
    {
        var s = await Streams.GetAsync((await AuthState).User, Id);
        if (s is null)
        {
            notFound = true;
            return;
        }
        stream = s;
        publish = Endpoints.Publish(s).ToList();
        read = Endpoints.Read(s).ToList();
        obs = Endpoints.Obs(s);
    }

    private async Task LoadPaywallAsync()
    {
        offers = await Paywall.OffersAsync(stream!.Id, activeOnly: false);
        providers = await Paywall.ProvidersForOwnerAsync(stream.OwnerId);
        sales = await Paywall.SalesAsync(stream.Id);
    }

    private void OnLive(MtxPath? path) => live = path;

    private async Task TogglePaywall()
    {
        var enabled = !stream!.PaywallEnabled;
        var error = await Paywall.SetPaywallAsync((await AuthState).User, stream.Id, enabled);
        await LoadAsync();
        await LoadPaywallAsync();
        ShowPaywall(error ?? (enabled ? L["Paywall is on. Share the watch page with your audience."] : L["Paywall is off."]), error is not null);
    }

    private void NewOffer()
    {
        editingOfferId = null;
        offerInput = new OfferInput();
    }

    private void EditOffer(StreamOffer o)
    {
        editingOfferId = o.Id;
        offerInput = new OfferInput
        {
            Name = o.Name,
            Description = o.Description,
            Price = o.PriceCents / 100m,
            AccessHours = o.AccessHours,
            Active = o.Active,
        };
    }

    private async Task SaveOffer()
    {
        var ok = await Paywall.SaveOfferAsync((await AuthState).User, stream!.Id, editingOfferId, offerInput!);
        offerInput = null;
        await LoadPaywallAsync();
        ShowPaywall(ok ? L["Offer saved."] : L["Saving failed."], !ok);
    }

    private async Task DeleteOffer(StreamOffer o)
    {
        await Paywall.DeleteOfferAsync((await AuthState).User, stream!.Id, o.Id);
        await LoadPaywallAsync();
        if (stream.PaywallEnabled && !offers.Any(x => x.Active))
        {
            await Paywall.SetPaywallAsync((await AuthState).User, stream.Id, false);
            await LoadAsync();
            ShowPaywall(L["Offer deleted. There is no active offer left, so the paywall is off."], true);
        }
        else
        {
            ShowPaywall(L["Offer deleted."], false);
        }
    }

    private void ShowPaywall(string text, bool isError)
    {
        paywallMessage = text;
        paywallMessageIsError = isError;
    }

    private string ProviderLabel(PaymentProvider p) => p switch
    {
        PaymentProvider.Mollie => "iDEAL",
        PaymentProvider.PayPal => "PayPal",
        _ => L["test payment"],
    };

    private string StatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.Paid => L["paid"],
        OrderStatus.Failed => L["failed"],
        OrderStatus.Canceled => L["canceled"],
        OrderStatus.Expired => L["expired"],
        _ => L["open"],
    };

    private string Hours(int hours) =>
        hours % 24 == 0
            ? (hours == 24 ? L["1 day"] : L["{0} days", hours / 24])
            : (hours == 1 ? L["1 hour"] : L["{0} hours", hours]);
}
