@page "/portal/streams/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject StreamService Streams
@inject PaywallService Paywall
@inject StreamEndpointBuilder Endpoints
@inject NavigationManager Nav

<PageTitle>@(stream?.DisplayName ?? "Stream")</PageTitle>

@if (notFound)
{
    <h1>Stream not found</h1>
    <a href="portal">Back to my streams</a>
}
else if (stream is null)
{
    <p>Loading…</p>
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
        <a class="btn btn-sm btn-link px-0 me-1" href="portal">← My streams</a>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="mb-0 me-2">@stream.DisplayName</h1>
        <StreamStateBadge Stream="stream" Live="live" />
        @if (stream.PaywallEnabled)
        {
            <span class="badge text-bg-warning">Paywall on</span>
        }
        else if (stream.PublicRead)
        {
            <span class="badge text-bg-info">Public</span>
        }
    </div>

    <StatsBar Stream="stream" OnLive="OnLive" />

    <div class="row g-4">
        <div class="col-xl-8">
            <StreamPlayer Stream="stream" User="@stream.ReadUser" Pass="@stream.ReadPassword" />
            <p class="small text-secondary mt-2">
                @if (live?.IsLive == true)
                {
                    <span>Your stream is coming in. If you see video above, your viewers see it too.</span>
                }
                else if (stream.SourceType == StreamSourceType.Publisher)
                {
                    <span>No video yet. Start your broadcast with the details under <em>Connect</em>; the preview starts automatically.</span>
                }
                else
                {
                    <span>No video yet. The server pulls the source @(stream.SourceOnDemand ? "as soon as someone watches" : "as soon as it is reachable").</span>
                }
            </p>

            <div class="card mt-3">
                <div class="card-header"><strong>Details</strong></div>
                <div class="card-body">
                    <dl class="row mb-0 small">
                        <dt class="col-sm-4">Server</dt><dd class="col-sm-8">@stream.Server!.Name (@stream.Server.PublicHost)</dd>
                        <dt class="col-sm-4">Path</dt><dd class="col-sm-8"><code>@stream.Name</code></dd>
                        <dt class="col-sm-4">Type</dt><dd class="col-sm-8">@(stream.SourceType == StreamSourceType.Publisher ? "You broadcast it yourself" : "The server pulls a source")</dd>
                        <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(stream.Enabled ? "Enabled" : "Disabled by the administrator")</dd>
                        <dt class="col-sm-4">Recording</dt><dd class="col-sm-8">@(stream.Record ? "On" : "Off")</dd>
                        @if (stream.MaxReaders > 0)
                        {
                            <dt class="col-sm-4">Max. viewers</dt><dd class="col-sm-8">@stream.MaxReaders</dd>
                        }
                        @if (!string.IsNullOrEmpty(stream.Description))
                        {
                            <dt class="col-sm-4">Description</dt><dd class="col-sm-8">@stream.Description</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card connect-panel">
                <div class="card-header pb-0">
                    <ul class="nav nav-tabs card-header-tabs">
                        @foreach (var (key, label) in tabs)
                        {
                            <li class="nav-item">
                                <button type="button" class="nav-link @(tab == key ? "active" : "")" @onclick="() => tab = key">@label</button>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-body">
                    @if (tab == "connect")
                    {
                        @if (stream.SourceType == StreamSourceType.Publisher)
                        {
                            <h6>OBS Studio / Streamlabs / vMix</h6>
                            <p class="small text-secondary mb-2">Settings → Stream → Service: <em>Custom…</em></p>
                            <CopyField Label="Server" Value="@obs!.Server" />
                            <CopyField Label="Stream key" Value="@obs.StreamKey" Secret="true" />
                            <hr />
                            <h6>Credentials</h6>
                            <CopyField Label="Username" Value="@stream.PublishUser" />
                            <CopyField Label="Password" Value="@stream.PublishPassword" Secret="true" />
                            <hr />
                            <h6>Other protocols</h6>
                            @foreach (var e in publish.Where(e => e.Protocol is not "WebRTC (browser)"))
                            {
                                <CopyField Label="@e.Protocol" Value="@e.Url" Secret="@e.HasCredentials" />
                                @if (e.Note is not null)
                                {
                                    <p class="small text-secondary mt-n2">@e.Note</p>
                                }
                            }
                            <p class="small mb-0">
                                No software? <a href="@BrowserPublishUrl" target="_blank" rel="noopener">Broadcast from your browser</a>
                                (webcam or screen, sign in with the credentials above).
                            </p>
                        }
                        else
                        {
                            <p class="small">The server pulls this stream; you don't need to send anything yourself.</p>
                            <CopyField Label="Source" Value="@(stream.SourceUrl ?? "")" Secret="true" />
                        }
                    }
                    else if (tab == "share")
                    {
                        <h6>Watch page</h6>
                        <p class="small text-secondary mb-2">
                            @if (stream.PaywallEnabled)
                            {
                                <span>Viewers buy a ticket here and then watch right away in the browser.</span>
                            }
                            else if (stream.PublicRead)
                            {
                                <span>Anyone with this link can watch.</span>
                            }
                            else
                            {
                                <span>This stream is private: turn on the paywall to sell tickets, or ask the administrator to make it public.</span>
                            }
                        </p>
                        <CopyField Value="@WatchUrl" />
                        <a class="btn btn-sm btn-outline-primary mb-3" href="@WatchUrl" target="_blank" rel="noopener">Open watch page</a>
                        <hr />
                        <h6>Viewing credentials</h6>
                        <p class="small text-secondary mb-2">For your own use or regular viewers, separate from the paywall.</p>
                        <CopyField Label="Username" Value="@stream.ReadUser" />
                        <CopyField Label="Password" Value="@stream.ReadPassword" Secret="true" />
                        @foreach (var e in read.Where(e => e.Protocol is "HLS" or "RTSP" or "SRT"))
                        {
                            <CopyField Label="@e.Protocol" Value="@e.Url" Secret="@e.HasCredentials" />
                        }
                    }
                    else
                    {
                        @if (paywallMessage is not null)
                        {
                            <div class="alert alert-@(paywallMessageIsError ? "danger" : "success") small py-2">@paywallMessage</div>
                        }
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <strong>Paywall</strong>
                                <span class="badge @(stream.PaywallEnabled ? "text-bg-warning" : "text-bg-secondary") ms-1">@(stream.PaywallEnabled ? "on" : "off")</span>
                                <div class="small text-secondary">Viewers pay for access.</div>
                            </div>
                            <button id="paywall" class="btn btn-sm @(stream.PaywallEnabled ? "btn-outline-secondary" : "btn-warning")" @onclick="TogglePaywall">
                                @(stream.PaywallEnabled ? "Turn off" : "Turn on")
                            </button>
                        </div>
                        <p class="small text-secondary">
                            Payment via @(providers.Count > 0 ? string.Join(", ", providers.Select(ProviderLabel)) : "no payment method yet")
                            · <a href="portal/payments">Payment settings</a>
                        </p>

                        <h6 class="mt-3">Offers</h6>
                        @if (offers.Count == 0)
                        {
                            <p class="small text-secondary">No offers yet. Add a day ticket or a season pass, for example.</p>
                        }
                        @foreach (var o in offers)
                        {
                            <div class="offer-card mb-2 @(o.Active ? "" : "opacity-50")">
                                <div class="d-flex justify-content-between">
                                    <strong>@o.Name</strong>
                                    <span>@Format.Money(o.PriceCents, o.Currency)</span>
                                </div>
                                <div class="small text-secondary">Access @Format.Hours(o.AccessHours)@(o.Active ? "" : " · inactive")</div>
                                @if (!string.IsNullOrEmpty(o.Description))
                                {
                                    <div class="small">@o.Description</div>
                                }
                                <div class="mt-1">
                                    <button class="btn btn-link btn-sm p-0 me-2" @onclick="() => EditOffer(o)">Edit</button>
                                    <button class="btn btn-link btn-sm p-0 text-danger" @onclick="() => DeleteOffer(o)">Delete</button>
                                </div>
                            </div>
                        }

                        @if (offerInput is null)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="NewOffer">+ Add offer</button>
                        }
                        else
                        {
                            <EditForm Model="offerInput" OnValidSubmit="SaveOffer" FormName="offer" class="offer-card mb-2">
                                <DataAnnotationsValidator />
                                <div class="mb-2">
                                    <label class="form-label small" for="offer-name">Name</label>
                                    <InputText id="offer-name" class="form-control form-control-sm" @bind-Value="offerInput.Name" placeholder="Day ticket, HD version, season pass…" />
                                    <ValidationMessage For="() => offerInput.Name" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small" for="offer-desc">Description (optional)</label>
                                    <InputText id="offer-desc" class="form-control form-control-sm" @bind-Value="offerInput.Description" />
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label small" for="offer-price">Price (€)</label>
                                        <InputNumber id="offer-price" class="form-control form-control-sm" @bind-Value="offerInput.Price" step="0.01" />
                                        <ValidationMessage For="() => offerInput.Price" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small" for="offer-hours">Access (hours)</label>
                                        <InputNumber id="offer-hours" class="form-control form-control-sm" @bind-Value="offerInput.AccessHours" />
                                        <ValidationMessage For="() => offerInput.AccessHours" />
                                    </div>
                                </div>
                                <div class="form-check mb-2">
                                    <InputCheckbox id="offer-active" class="form-check-input" @bind-Value="offerInput.Active" />
                                    <label class="form-check-label small" for="offer-active">For sale</label>
                                </div>
                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => offerInput = null">Cancel</button>
                            </EditForm>
                        }

                        <h6 class="mt-4">Sales</h6>
                        @if (sales is not null)
                        {
                            <div class="d-flex gap-3 small mb-2">
                                <div><div class="text-secondary">Sold</div><strong>@sales.PaidCount</strong></div>
                                <div><div class="text-secondary">Revenue</div><strong>@Format.Money(sales.RevenueCents, "EUR")</strong></div>
                                <div><div class="text-secondary">Valid tickets</div><strong>@sales.ActiveTickets</strong></div>
                            </div>
                            @if (sales.Recent.Count > 0)
                            {
                                <table class="table table-sm small mb-0">
                                    <tbody>
                                        @foreach (var o in sales.Recent)
                                        {
                                            <tr>
                                                <td>@o.CreatedAt.ToLocalTime().ToString("dd-MM HH:mm")</td>
                                                <td>@o.OfferName<div class="text-secondary">@(o.BuyerEmail ?? ProviderLabel(o.Provider))</div></td>
                                                <td class="text-end">@Format.Money(o.AmountCents, o.Currency)<div>@StatusLabel(o.Status)</div></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private static readonly (string Key, string Label)[] tabs = [("connect", "Connect"), ("share", "Share"), ("paywall", "Paywall")];

    private StreamDefinition? stream;
    private List<StreamEndpoint> publish = [];
    private List<StreamEndpoint> read = [];
    private ObsSettings? obs;
    private MtxPath? live;
    private bool notFound;
    private string tab = "connect";

    private List<StreamOffer> offers = [];
    private List<PaymentProvider> providers = [];
    private SalesSummary? sales;
    private OfferInput? offerInput;
    private int? editingOfferId;
    private string? paywallMessage;
    private bool paywallMessageIsError;

    private string WatchUrl => Nav.ToAbsoluteUri($"watch/{stream!.WatchSlug}").ToString();

    private string BrowserPublishUrl => publish.FirstOrDefault(e => e.Protocol == "WebRTC (browser)")?.Url ?? "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (stream is not null)
            await LoadPaywallAsync();
    }

    private async Task LoadAsync()
    {
        var s = await Streams.GetAsync((await AuthState).User, Id);
        if (s is null)
        {
            notFound = true;
            return;
        }
        stream = s;
        publish = Endpoints.Publish(s).ToList();
        read = Endpoints.Read(s).ToList();
        obs = Endpoints.Obs(s);
    }

    private async Task LoadPaywallAsync()
    {
        offers = await Paywall.OffersAsync(stream!.Id, activeOnly: false);
        providers = await Paywall.ProvidersForOwnerAsync(stream.OwnerId);
        sales = await Paywall.SalesAsync(stream.Id);
    }

    private void OnLive(MtxPath? path) => live = path;

    private async Task TogglePaywall()
    {
        var enabled = !stream!.PaywallEnabled;
        var error = await Paywall.SetPaywallAsync((await AuthState).User, stream.Id, enabled);
        await LoadAsync();
        await LoadPaywallAsync();
        ShowPaywall(error ?? (enabled ? "Paywall is on. Share the watch page with your audience." : "Paywall is off."), error is not null);
    }

    private void NewOffer()
    {
        editingOfferId = null;
        offerInput = new OfferInput();
    }

    private void EditOffer(StreamOffer o)
    {
        editingOfferId = o.Id;
        offerInput = new OfferInput
        {
            Name = o.Name,
            Description = o.Description,
            Price = o.PriceCents / 100m,
            AccessHours = o.AccessHours,
            Active = o.Active,
        };
    }

    private async Task SaveOffer()
    {
        var ok = await Paywall.SaveOfferAsync((await AuthState).User, stream!.Id, editingOfferId, offerInput!);
        offerInput = null;
        await LoadPaywallAsync();
        ShowPaywall(ok ? "Offer saved." : "Saving failed.", !ok);
    }

    private async Task DeleteOffer(StreamOffer o)
    {
        await Paywall.DeleteOfferAsync((await AuthState).User, stream!.Id, o.Id);
        await LoadPaywallAsync();
        if (stream.PaywallEnabled && !offers.Any(x => x.Active))
        {
            await Paywall.SetPaywallAsync((await AuthState).User, stream.Id, false);
            await LoadAsync();
            ShowPaywall("Offer deleted. There is no active offer left, so the paywall is off.", true);
        }
        else
        {
            ShowPaywall("Offer deleted.", false);
        }
    }

    private void ShowPaywall(string text, bool isError)
    {
        paywallMessage = text;
        paywallMessageIsError = isError;
    }

    private static string ProviderLabel(PaymentProvider p) => p switch
    {
        PaymentProvider.Mollie => "iDEAL",
        PaymentProvider.PayPal => "PayPal",
        _ => "test payment",
    };

    private static string StatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.Paid => "paid",
        OrderStatus.Failed => "failed",
        OrderStatus.Canceled => "canceled",
        OrderStatus.Expired => "expired",
        _ => "open",
    };
}
