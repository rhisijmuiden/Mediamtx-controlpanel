@page "/servers/new"
@page "/servers/{Id:int}"
@attribute [Authorize(Roles = Roles.Admin)]
@rendermode InteractiveServer
@using MediaMtxPanel.Options
@using Microsoft.Extensions.Options
@inject ServerService ServerAdmin
@inject NavigationManager Nav
@inject IOptions<PanelOptions> PanelOptions

<PageTitle>@(IsNew ? "Add server" : "Server")</PageTitle>

@if (notFound)
{
    <h1>Server not found</h1>
    <a href="servers">Back</a>
}
else if (input is null)
{
    <p>Loading…</p>
}
else
{
    <h1>@(IsNew ? "Add MediaMTX server" : server!.Name)</h1>

    @if (Created)
    {
        <div class="alert alert-success">
            <strong>Server added.</strong> Put the configuration below in this server's <code>mediamtx.yml</code>,
            restart MediaMTX and then click <em>Test connection</em>.
        </div>
    }
    @if (message is not null)
    {
        <div class="alert alert-@(isError ? "danger" : "success")">@message</div>
    }

    <div class="row g-4">
        <div class="col-xl-6">
            <EditForm Model="input" OnValidSubmit="Save" FormName="server">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="name">Name</label>
                        <InputText id="name" class="form-control" @bind-Value="input.Name" placeholder="e.g. Amsterdam-1" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="desc">Description</label>
                        <InputText id="desc" class="form-control" @bind-Value="input.Description" />
                    </div>

                    <div class="col-12"><h2 class="h6 mb-0 mt-2">Control API (how the panel reaches the server)</h2></div>
                    <div class="col-12">
                        <label class="form-label" for="api">API URL</label>
                        <InputText id="api" class="form-control font-monospace" @bind-Value="input.ApiUrl" placeholder="http://10.0.0.21:9997" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="apiuser">API user</label>
                        <InputText id="apiuser" class="form-control font-monospace" @bind-Value="input.ApiUser" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="apipass">API password</label>
                        <InputText id="apipass" class="form-control font-monospace" @bind-Value="input.ApiPassword" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="metrics">Metrics URL (optional)</label>
                        <InputText id="metrics" class="form-control font-monospace" @bind-Value="input.MetricsUrl" placeholder="http://10.0.0.21:9100/metrics" />
                        <div class="form-text">
                            Prometheus node_exporter on the server (<code>apt install prometheus-node-exporter</code>), for CPU, RAM and network in the customer portal.
                            You can leave this empty if MediaMTX runs on the same machine as the panel (127.0.0.1).
                        </div>
                        <ValidationMessage For="() => input.MetricsUrl" />
                    </div>

                    <div class="col-12"><h2 class="h6 mb-0 mt-2">Public (how broadcasters and viewers reach the server)</h2></div>
                    <div class="col-md-6">
                        <label class="form-label" for="host">Host or IP</label>
                        <InputText id="host" class="form-control font-monospace" @bind-Value="input.PublicHost" placeholder="stream1.example.com" />
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" id="https" @bind-Value="input.HttpsUrls" />
                            <label class="form-check-label" for="https">https:// for HLS and WebRTC</label>
                        </div>
                    </div>
                    <div class="col"><label class="form-label small" for="rtsp">RTSP</label><InputNumber id="rtsp" class="form-control" @bind-Value="input.RtspPort" /></div>
                    <div class="col"><label class="form-label small" for="rtmp">RTMP</label><InputNumber id="rtmp" class="form-control" @bind-Value="input.RtmpPort" /></div>
                    <div class="col"><label class="form-label small" for="srt">SRT</label><InputNumber id="srt" class="form-control" @bind-Value="input.SrtPort" /></div>
                    <div class="col"><label class="form-label small" for="hls">HLS</label><InputNumber id="hls" class="form-control" @bind-Value="input.HlsPort" /></div>
                    <div class="col"><label class="form-label small" for="webrtc">WebRTC</label><InputNumber id="webrtc" class="form-control" @bind-Value="input.WebRtcPort" /></div>

                    <div class="col-12">
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" id="enabled" @bind-Value="input.Enabled" />
                            <label class="form-check-label" for="enabled">Enabled (when disabled, the server refuses all connections)</label>
                        </div>
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" id="unmanaged" @bind-Value="input.RemoveUnmanagedPaths" />
                            <label class="form-check-label" for="unmanaged">Remove paths that are not in the panel</label>
                        </div>
                    </div>
                </div>
                <div class="mt-4 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">@(IsNew ? "Add server" : "Save")</button>
                    @if (!IsNew)
                    {
                        <button type="button" class="btn btn-outline-success" @onclick="Test" disabled="@testing">@(testing ? "Testing…" : "Test connection")</button>
                        @if (!confirmDelete)
                        {
                            <button type="button" class="btn btn-outline-danger" @onclick="() => confirmDelete = true">Delete</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger" @onclick="Delete">Yes, delete</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => confirmDelete = false">No</button>
                        }
                    }
                    <a class="btn btn-outline-secondary" href="servers">Back</a>
                </div>
            </EditForm>
        </div>

        @if (!IsNew)
        {
            <div class="col-xl-6">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Configuration for mediamtx.yml</strong>
                        <button class="btn btn-link btn-sm p-0" @onclick="RegenerateSecret">New secret</button>
                    </div>
                    <div class="card-body">
                        <p class="small">Add this to this server's <code>mediamtx.yml</code> and restart MediaMTX. The panel must be reachable at the address in <code>authHTTPAddress</code>, and the server must open the API port to the panel.</p>
                        <pre class="cmd">@ConfigSnippet</pre>
                        <CopyField Value="@ConfigSnippet" Label="Copy" />
                        <p class="small text-secondary mb-0">Or set this environment variable instead (e.g. in Docker or systemd):</p>
                        <CopyField Value="@($"MTX_AUTHHTTPADDRESS={HookUrl}")" />
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery] public bool Created { get; set; }

    private bool IsNew => Id is null;
    private ServerInput? input;
    private MediaServer? server;
    private bool notFound;
    private bool testing;
    private bool confirmDelete;
    private string? message;
    private bool isError;

    private string HookBase => (string.IsNullOrWhiteSpace(PanelOptions.Value.HookBaseUrl)
        ? Nav.BaseUri
        : PanelOptions.Value.HookBaseUrl).TrimEnd('/');

    private string HookUrl => $"{HookBase}/api/mediamtx/auth?secret={server!.HookSecret}";

    private string ConfigSnippet => $"""
        authMethod: http
        authHTTPAddress: {HookUrl}
        authHTTPExclude: []

        api: true
        apiAddress: :9997

        rtspAddress: :{server!.RtspPort}
        rtmpAddress: :{server.RtmpPort}
        srtAddress: :{server.SrtPort}
        hlsAddress: :{server.HlsPort}
        webrtcAddress: :{server.WebRtcPort}
        webrtcAdditionalHosts: [{server.PublicHost}]

        # Paths are created by the panel.
        paths: {"{}"}
        """;

    protected override async Task OnParametersSetAsync()
    {
        if (IsNew)
        {
            input ??= new ServerInput();
            return;
        }
        server = await ServerAdmin.GetAsync(Id!.Value);
        if (server is null)
        {
            notFound = true;
            return;
        }
        input = ServerInput.From(server);
    }

    private async Task Save()
    {
        message = null;
        if (await ServerAdmin.NameExistsAsync(input!.Name.Trim(), Id))
        {
            Show("A server with this name already exists.", true);
            return;
        }

        if (IsNew)
        {
            var created = await ServerAdmin.CreateAsync(input);
            Nav.NavigateTo($"servers/{created.Id}?created=true");
            return;
        }

        server = await ServerAdmin.UpdateAsync(Id!.Value, input);
        var test = server!.Enabled ? await ServerAdmin.TestAndSyncAsync(server.Id) : null;
        Show(test is null ? "Saved." : $"Saved. {test.Message}", test is { Ok: false });
    }

    private async Task Test()
    {
        testing = true;
        var r = await ServerAdmin.TestAndSyncAsync(Id!.Value);
        testing = false;
        Show(r.Message, !r.Ok);
    }

    private async Task RegenerateSecret()
    {
        server = await ServerAdmin.RegenerateHookSecretAsync(Id!.Value);
        Show("New secret created. Update the configuration on the server; until then the panel rejects requests from this server.", false);
    }

    private async Task Delete()
    {
        var error = await ServerAdmin.DeleteAsync(Id!.Value);
        if (error is null)
            Nav.NavigateTo("servers");
        else
        {
            confirmDelete = false;
            Show(error, true);
        }
    }

    private void Show(string text, bool error)
    {
        message = text;
        isError = error;
    }
}
