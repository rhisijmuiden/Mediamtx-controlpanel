@page "/servers/new"
@page "/servers/{Id:int}"
@attribute [Authorize(Roles = Roles.Admin)]
@rendermode InteractiveServer
@using MediaMtxPanel.Options
@using Microsoft.Extensions.Options
@inject ServerService ServerAdmin
@inject NavigationManager Nav
@inject IOptions<PanelOptions> PanelOptions
@inject WebPortInfo Port

<AppPageTitle Text="@(IsNew ? L["Add server"] : server?.Name ?? L["Server"])" />

<a class="back-link" href="servers"><i class="bi bi-arrow-left"></i> @L["MediaMTX servers"]</a>

@if (notFound)
{
    <div class="empty-state">
        <i class="bi bi-hdd-network"></i>
        <p class="mb-3">@L["Server not found"]</p>
        <a class="btn btn-outline-secondary" href="servers"><i class="bi bi-arrow-left"></i> @L["Back"]</a>
    </div>
}
else if (input is null)
{
    <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>@L["Loading…"]</p>
}
else
{
    <div class="page-header">
        <div>
            <h1><i class="bi @(IsNew ? "bi-plus-circle" : "bi-hdd-rack") text-primary"></i> @(IsNew ? L["Add MediaMTX server"] : server!.Name)</h1>
            <p class="page-subtitle">
                @(IsNew
                    ? L["Tell the panel how to reach the server's control API and how broadcasters and viewers reach it. The panel can set up MediaMTX on the server over SSH, or you follow the steps on the right."]
                    : L["Connection, public address and statistics of this server. Configure MediaMTX over SSH or by hand on the right."])
            </p>
        </div>
        @if (!IsNew)
        {
            <div class="page-actions">
                <button type="button" class="btn btn-outline-success" @onclick="Test" disabled="@testing">
                    @if (testing)
                    {
                        <span class="spinner-border spinner-border-sm"></span> @L["Testing…"]
                    }
                    else
                    {
                        <i class="bi bi-plug"></i> @L["Test connection"]
                    }
                </button>
            </div>
        }
    </div>

    @if (Created && Setup == "ok")
    {
        <div class="alert alert-success d-flex gap-2">
            <i class="bi bi-check-circle"></i>
            <div>
                <strong>@L["Server added."]</strong>
                @L["MediaMTX on this server was configured over SSH and the panel is connected."]
            </div>
        </div>
    }
    else if (Created && Setup == "api")
    {
        <div class="alert alert-warning d-flex gap-2">
            <i class="bi bi-exclamation-triangle"></i>
            <div>
                <strong>@L["Server added."]</strong>
                @L["MediaMTX on this server was configured over SSH, but the panel cannot reach its control API yet. Check that port {0} on the server is open to the panel and that the API URL is correct, then click Test connection.", ApiPort]
            </div>
        </div>
    }
    else if (Created)
    {
        <div class="alert alert-success d-flex gap-2">
            <i class="bi bi-check-circle"></i>
            <div>
                <strong>@L["Server added."]</strong>
                @L["Set up MediaMTX on the server as described on the right, or configure it over SSH, and then click Test connection."]
            </div>
        </div>
    }
    @if (message is not null)
    {
        <div class="alert alert-@(isError ? "danger" : "success") d-flex align-items-center gap-2">
            <i class="bi @(isError ? "bi-exclamation-octagon" : "bi-check-circle")"></i> <span>@message</span>
        </div>
    }

    <div class="row g-4">
        <div class="col-xxl-7">
            <EditForm Model="input" OnValidSubmit="Save" FormName="server">
                <LocalizedValidator />
                <div class="card">
                    <div class="card-body">
                        <ValidationSummary class="text-danger small mb-3" />

                        <section class="form-section">
                            <header>
                                <h2><i class="bi bi-tag me-1 text-primary"></i> @L["General"]</h2>
                                <p>@L["A name to recognize the server by, for example its location."]</p>
                            </header>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label" for="name">@L["Name"]</label>
                                    <InputText id="name" class="form-control" @bind-Value="input.Name" placeholder="@L["e.g. Amsterdam-1"]" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="desc">@L["Description"]</label>
                                    <InputText id="desc" class="form-control" @bind-Value="input.Description" />
                                </div>
                                <div class="col-12">
                                    <div class="form-check form-switch">
                                        <InputCheckbox class="form-check-input" id="enabled" @bind-Value="input.Enabled" />
                                        <label class="form-check-label" for="enabled">@L["Enabled (when disabled, the server refuses all connections)"]</label>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="form-section">
                            <header>
                                <h2><i class="bi bi-plug me-1 text-primary"></i> @L["Control API"]</h2>
                                <p>@L["How the panel reaches the server. The API port must be open to the panel."]</p>
                            </header>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label" for="api">@L["API URL"]</label>
                                    <InputText id="api" class="form-control font-monospace" @bind-Value="input.ApiUrl" placeholder="http://10.0.0.21:9997" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="apiuser">@L["API user"]</label>
                                    <InputText id="apiuser" class="form-control font-monospace" @bind-Value="input.ApiUser" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="apipass">@L["API password"]</label>
                                    <InputText id="apipass" class="form-control font-monospace" @bind-Value="input.ApiPassword" />
                                </div>
                                <div class="col-12">
                                    <div class="form-check form-switch">
                                        <InputCheckbox class="form-check-input" id="unmanaged" @bind-Value="input.RemoveUnmanagedPaths" />
                                        <label class="form-check-label" for="unmanaged">@L["Remove paths that are not in the panel"]</label>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="form-section">
                            <header>
                                <h2><i class="bi bi-globe2 me-1 text-primary"></i> @L["Public address and ports"]</h2>
                                <p>@L["How broadcasters and viewers reach the server. These values are used in the links and settings shown to customers."]</p>
                            </header>
                            <div class="row g-3">
                                <div class="col-md-7">
                                    <label class="form-label" for="host">@L["Host or IP"]</label>
                                    <InputText id="host" class="form-control font-monospace" @bind-Value="input.PublicHost" placeholder="stream1.example.com" />
                                </div>
                                <div class="col-md-5 d-flex align-items-end">
                                    <div class="form-check form-switch mb-2">
                                        <InputCheckbox class="form-check-input" id="https" @bind-Value="input.HttpsUrls" />
                                        <label class="form-check-label" for="https">@L["https:// for HLS and WebRTC"]</label>
                                    </div>
                                </div>
                                <div class="col-6 col-md"><label class="form-label small" for="rtsp">RTSP</label><InputNumber id="rtsp" class="form-control" @bind-Value="input.RtspPort" /></div>
                                <div class="col-6 col-md"><label class="form-label small" for="rtmp">RTMP</label><InputNumber id="rtmp" class="form-control" @bind-Value="input.RtmpPort" /></div>
                                <div class="col-6 col-md"><label class="form-label small" for="srt">SRT</label><InputNumber id="srt" class="form-control" @bind-Value="input.SrtPort" /></div>
                                <div class="col-6 col-md"><label class="form-label small" for="hls">HLS</label><InputNumber id="hls" class="form-control" @bind-Value="input.HlsPort" /></div>
                                <div class="col-6 col-md"><label class="form-label small" for="webrtc">WebRTC</label><InputNumber id="webrtc" class="form-control" @bind-Value="input.WebRtcPort" /></div>
                            </div>
                        </section>

                        <section class="form-section">
                            <header>
                                <h2><i class="bi bi-speedometer2 me-1 text-primary"></i> @L["Statistics"]</h2>
                                <p>@L["CPU, RAM and network of the server in the customer portal."]</p>
                            </header>
                            <div>
                                <label class="form-label" for="metrics">@L["Metrics URL (optional)"]</label>
                                <InputText id="metrics" class="form-control font-monospace" @bind-Value="input.MetricsUrl" placeholder="http://10.0.0.21:9100/metrics" />
                                <div class="form-text">
                                    @L["Prometheus node_exporter on the server:"] <code>apt install prometheus-node-exporter</code>.
                                    @L["You can leave this empty if MediaMTX runs on the same machine as the panel (127.0.0.1)."]
                                </div>
                                <ValidationMessage For="() => input.MetricsUrl" />
                            </div>
                        </section>

                        @if (IsNew)
                        {
                            <section class="form-section">
                                <header>
                                    <h2><i class="bi bi-terminal me-1 text-primary"></i> @L["Setup over SSH"]</h2>
                                    <p>@L["The panel logs in to the server, sets up MediaMTX for the panel (and installs it if needed), restarts it and adds the server once the connection works. Without SSH, follow the steps on the right."]</p>
                                </header>
                                <div>
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="usessh" @bind="useSsh" disabled="@running" />
                                        <label class="form-check-label" for="usessh">@L["Configure MediaMTX on the server over SSH"]</label>
                                    </div>
                                    @if (useSsh)
                                    {
                                        <SshSetupFields Login="ssh" Disabled="running" HostChanged="FillFromSshHost" />
                                    }
                                </div>
                            </section>
                        }
                    </div>
                    <div class="card-footer bg-white d-flex flex-wrap gap-2 py-3">
                        <button type="submit" class="btn btn-primary" disabled="@running">
                            @if (running)
                            {
                                <span class="spinner-border spinner-border-sm"></span> @L["Setting up…"]
                            }
                            else
                            {
                                <i class="bi @(IsNew ? "bi-plus-lg" : "bi-check-lg")"></i> @(IsNew ? (useSsh ? L["Set up and add server"] : L["Add server"]) : L["Save"])
                            }
                        </button>
                        <a class="btn btn-outline-secondary" href="servers"><i class="bi bi-arrow-left"></i> @L["Back"]</a>
                        @if (!IsNew)
                        {
                            <div class="ms-auto d-flex flex-wrap gap-2">
                                @if (!confirmDelete)
                                {
                                    <button type="button" class="btn btn-outline-danger" @onclick="() => confirmDelete = true"><i class="bi bi-trash"></i> @L["Delete"]</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-danger" @onclick="Delete"><i class="bi bi-trash"></i> @L["Yes, delete"]</button>
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => confirmDelete = false"><i class="bi bi-x-lg"></i> @L["No"]</button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </EditForm>

            @if (setupLog.Count > 0)
            {
                <div class="card mt-4">
                    <div class="card-header"><i class="bi bi-journal-text"></i> @L["Setup log"]</div>
                    <div class="card-body"><pre class="cmd small mb-0">@string.Join("\n", setupLog)</pre></div>
                </div>
            }
        </div>

        <div class="col-xxl-5">
            @if (!IsNew)
            {
                <div class="card mb-4">
                    <div class="card-header"><i class="bi bi-terminal"></i> @L["Configure over SSH"]</div>
                    <div class="card-body">
                        @if (!showSsh)
                        {
                            <p class="small text-secondary mb-3">
                                @L["Let the panel log in to this server and set up MediaMTX for it, for example after creating a new secret or changing the API URL."]
                            </p>
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => showSsh = true">
                                <i class="bi bi-terminal"></i> @L["Configure over SSH"]
                            </button>
                        }
                        else
                        {
                            <SshSetupFields Login="ssh" Disabled="running" />
                            <button type="button" class="btn btn-primary mt-3" @onclick="ConfigureExisting" disabled="@running">
                                @if (running)
                                {
                                    <span class="spinner-border spinner-border-sm"></span> @L["Setting up…"]
                                }
                                else
                                {
                                    <i class="bi bi-gear"></i> @L["Configure MediaMTX"]
                                }
                            </button>
                        }
                    </div>
                </div>
            }
            <div class="card">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span><i class="bi bi-file-earmark-code"></i> @L["Manual setup"]</span>
                    @if (!IsNew)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="RegenerateSecret"
                                title="@L["Create a new hook secret; the old configuration stops working"]">
                            <i class="bi bi-arrow-repeat"></i> @L["New secret"]
                        </button>
                    }
                </div>
                <div class="card-body">
                    <p class="small">@L["To set up MediaMTX on the server yourself so that the panel can manage it:"]</p>
                    <ServerSetupGuide HookUrl="@HookUrl" ApiPort="ApiPort" PublicHost="@input.PublicHost"
                                      LastStep="@(IsNew ? L["Fill in this form and click Add server, then Test connection."] : L["Click Test connection."])" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery] public bool Created { get; set; }
    [SupplyParameterFromQuery] public string? Setup { get; set; }

    private bool IsNew => Id is null;
    private ServerInput? input;
    private MediaServer? server;
    private bool notFound;
    private bool testing;
    private bool confirmDelete;
    private string? message;
    private bool isError;

    // SSH setup. The login lives only in this page's memory and is never saved.
    private SshLoginInput ssh = new();
    private bool useSsh;
    private bool showSsh;
    private bool running;
    private readonly List<string> setupLog = [];

    /// <summary>A new server gets its secret up front, so the manual instructions can show the final configuration.</summary>
    private readonly string newHookSecret = CredentialGenerator.Password(32);

    private string HookBase => (string.IsNullOrWhiteSpace(PanelOptions.Value.HookBaseUrl)
        ? Nav.BaseUri
        : Port.Rewrite(PanelOptions.Value.HookBaseUrl)).TrimEnd('/');

    private string HookUrl => ssh.HookUrl(IsNew ? newHookSecret : server!.HookSecret);

    private int ApiPort => Uri.TryCreate(input?.ApiUrl, UriKind.Absolute, out var uri) && uri.Host.Length > 0 ? uri.Port : 9997;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(ssh.PanelUrl))
            ssh.PanelUrl = HookBase;
        if (IsNew)
        {
            input ??= new ServerInput();
            return;
        }
        server = await ServerAdmin.GetAsync(Id!.Value);
        if (server is null)
        {
            notFound = true;
            return;
        }
        input = ServerInput.From(server);
        if (string.IsNullOrEmpty(ssh.Host) && Uri.TryCreate(server.ApiUrl, UriKind.Absolute, out var api))
            ssh.Host = api.Host;
    }

    private async Task Save()
    {
        message = null;
        if (await ServerAdmin.NameExistsAsync(input!.Name.Trim(), Id))
        {
            Show(L["A server with this name already exists."], true);
            return;
        }

        if (IsNew && useSsh)
        {
            await AddWithSsh();
            return;
        }
        if (IsNew)
        {
            var created = await ServerAdmin.CreateAsync(input, newHookSecret);
            Nav.NavigateTo($"servers/{created.Id}?created=true");
            return;
        }

        server = await ServerAdmin.UpdateAsync(Id!.Value, input);
        var test = server!.Enabled ? await ServerAdmin.TestAndSyncAsync(server.Id) : null;
        Show(test is null ? L["Saved."] : $"{L["Saved."]} {test.Message}", test is { Ok: false });
    }

    /// <summary>
    /// Adds the server and configures it over SSH. When nothing could be changed on the server, the server is
    /// removed again so the admin can correct the details; once MediaMTX points at the panel, the server stays.
    /// </summary>
    private async Task AddWithSsh()
    {
        if (SshSetupFields.Validate(ssh, L) is { } problem)
        {
            Show(problem, true);
            return;
        }
        running = true;
        setupLog.Clear();
        var created = await ServerAdmin.CreateAsync(input!, newHookSecret);
        var result = await ServerAdmin.ConfigureOverSshAsync(created.Id, ssh, ssh.HookUrl(newHookSecret), Log);
        running = false;
        if (result.Configured)
        {
            ssh.ForgetSecrets();
            Nav.NavigateTo($"servers/{created.Id}?created=true&setup={(result.Ok ? "ok" : "api")}");
            return;
        }
        await ServerAdmin.DeleteAsync(created.Id);
        Show($"{result.Message} {L["The server was not added."]}", true);
    }

    private async Task ConfigureExisting()
    {
        if (SshSetupFields.Validate(ssh, L) is { } problem)
        {
            Show(problem, true);
            return;
        }
        running = true;
        setupLog.Clear();
        message = null;
        var result = await ServerAdmin.ConfigureOverSshAsync(Id!.Value, ssh, HookUrl, Log);
        running = false;
        if (result.Ok)
            ssh.ForgetSecrets();
        Show(result.Message, !result.Ok);
    }

    /// <summary>Called from the setup's worker thread; shows each step as it happens.</summary>
    private void Log(string line) => _ = InvokeAsync(() =>
    {
        setupLog.Add(line);
        StateHasChanged();
    });

    /// <summary>Suggests the API URL and public address from the SSH host while they are still empty.</summary>
    private void FillFromSshHost(string host)
    {
        host = host.Trim();
        if (host.Length == 0)
            return;
        if (string.IsNullOrWhiteSpace(input!.ApiUrl) || input.ApiUrl.Trim() is "http://" or "https://")
            input.ApiUrl = $"http://{host}:9997";
        if (string.IsNullOrWhiteSpace(input.PublicHost))
            input.PublicHost = host;
    }

    private async Task Test()
    {
        testing = true;
        var r = await ServerAdmin.TestAndSyncAsync(Id!.Value);
        testing = false;
        Show(r.Message, !r.Ok);
    }

    private async Task RegenerateSecret()
    {
        server = await ServerAdmin.RegenerateHookSecretAsync(Id!.Value);
        Show(L["New secret created. Update the configuration on the server; until then the panel rejects requests from this server."], false);
    }

    private async Task Delete()
    {
        var error = await ServerAdmin.DeleteAsync(Id!.Value);
        if (error is null)
            Nav.NavigateTo("servers");
        else
        {
            confirmDelete = false;
            Show(error, true);
        }
    }

    private void Show(string text, bool error)
    {
        message = text;
        isError = error;
    }
}
