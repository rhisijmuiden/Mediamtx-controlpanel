@page "/servers"
@attribute [Authorize(Roles = Roles.Admin)]
@rendermode InteractiveServer
@inject ServerService ServerAdmin
@inject MediaMtxStatus Status

<PageTitle>Servers</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">MediaMTX-servers</h1>
    <a class="btn btn-primary" href="servers/new">+ Server toevoegen</a>
</div>

@if (message is not null)
{
    <div class="alert alert-@(isError ? "danger" : "success")">@message</div>
}

@if (servers is null)
{
    <p>Laden…</p>
}
else if (servers.Count == 0)
{
    <div class="text-center text-secondary py-5">
        <p>Er zijn nog geen servers gekoppeld.</p>
        <a class="btn btn-primary" href="servers/new">Voeg je eerste MediaMTX-server toe</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Naam</th><th>API</th><th>Publiek adres</th><th class="text-end">Streams</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in servers)
                {
                    var state = Status.Get(s.Id);
                    <tr>
                        <td><a href="servers/@s.Id">@s.Name</a></td>
                        <td class="small font-monospace">@s.ApiUrl</td>
                        <td class="small font-monospace">@s.PublicHost</td>
                        <td class="text-end">@counts.GetValueOrDefault(s.Id)</td>
                        <td>
                            @if (!s.Enabled)
                            {
                                <span class="badge text-bg-secondary">Uitgeschakeld</span>
                            }
                            else if (state is null)
                            {
                                <span class="badge text-bg-light border">Onbekend</span>
                            }
                            else if (state.Connected)
                            {
                                <span class="badge text-bg-success">Online @state.Version</span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger" title="@state.Error">Niet bereikbaar</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Test(s)" disabled="@(testing == s.Id)">@(testing == s.Id ? "Testen…" : "Testen")</button>
                            <a class="btn btn-sm btn-outline-primary" href="servers/@s.Id">Instellingen</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<MediaServer>? servers;
    private Dictionary<int, int> counts = [];
    private int testing;
    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        servers = await ServerAdmin.ListAsync();
        counts = await ServerAdmin.StreamCountsAsync();
    }

    private async Task Test(MediaServer s)
    {
        testing = s.Id;
        var r = await ServerAdmin.TestAndSyncAsync(s.Id);
        testing = 0;
        message = $"{s.Name}: {r.Message}";
        isError = !r.Ok;
    }
}
