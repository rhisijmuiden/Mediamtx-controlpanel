@page "/servers"
@attribute [Authorize(Roles = Roles.Admin)]
@rendermode InteractiveServer
@inject ServerService ServerAdmin
@inject MediaMtxStatus Status

<AppPageTitle Text="@L["Servers"]" />

<div class="page-header">
    <div>
        <h1><i class="bi bi-hdd-network text-primary"></i> @L["MediaMTX servers"]</h1>
        <p class="page-subtitle">@L["The MediaMTX machines this panel controls. Streams run on one of these servers; the panel keeps their paths in sync and checks who may broadcast or watch."]</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="servers/new"><i class="bi bi-plus-lg"></i> @L["Add server"]</a>
    </div>
</div>

@if (message is not null)
{
    <div class="alert alert-@(isError ? "danger" : "success") d-flex align-items-center gap-2">
        <i class="bi @(isError ? "bi-exclamation-octagon" : "bi-check-circle")"></i> <span>@message</span>
    </div>
}

@if (servers is null)
{
    <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>@L["Loading…"]</p>
}
else if (servers.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-hdd-network"></i>
        <p class="mb-3">@L["No servers have been connected yet."]</p>
        <a class="btn btn-primary" href="servers/new"><i class="bi bi-plus-lg"></i> @L["Add your first MediaMTX server"]</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var s in servers)
        {
            var state = Status.Get(s.Id);
            <div class="col-md-6 col-xl-4">
                <div class="card entity-card h-100">
                    <div class="card-body">
                        <div class="entity-head">
                            <span class="avatar"><i class="bi bi-hdd-rack"></i></span>
                            <div class="flex-grow-1" style="min-width:0">
                                <div class="entity-title"><a href="servers/@s.Id" class="text-reset">@s.Name</a></div>
                                <div class="entity-sub">@(string.IsNullOrEmpty(s.Description) ? s.PublicHost : s.Description)</div>
                            </div>
                        </div>
                        <div class="entity-meta">
                            @if (!s.Enabled)
                            {
                                <span class="badge bg-secondary-subtle text-secondary-emphasis badge-dot">@L["Disabled"]</span>
                            }
                            else if (state is null)
                            {
                                <span class="badge text-bg-light border badge-dot">@L["Unknown"]</span>
                            }
                            else if (state.Connected)
                            {
                                <span class="badge bg-success-subtle text-success-emphasis badge-dot">@L["Online"] @state.Version</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger-emphasis badge-dot" title="@state.Error">@L["Unreachable"]</span>
                            }
                            <span class="badge text-bg-light border"><i class="bi bi-camera-video me-1"></i>@L["{0} stream(s)", counts.GetValueOrDefault(s.Id)]</span>
                        </div>
                        <dl class="info-list small mb-0">
                            <dt>@L["API"]</dt>
                            <dd class="font-monospace text-break">@s.ApiUrl</dd>
                            <dt>@L["Public address"]</dt>
                            <dd class="font-monospace text-break">@s.PublicHost</dd>
                        </dl>
                        @if (s.Enabled && state is { Connected: false, Error: not null })
                        {
                            <div class="small text-danger-emphasis text-break"><i class="bi bi-exclamation-triangle me-1"></i>@state.Error</div>
                        }
                        <div class="entity-actions">
                            <a class="btn btn-sm btn-outline-primary" href="servers/@s.Id"><i class="bi bi-gear"></i> @L["Settings"]</a>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Test(s)" disabled="@(testing == s.Id)"
                                    title="@L["Check the connection and apply all streams to this server"]">
                                @if (testing == s.Id)
                                {
                                    <span class="spinner-border spinner-border-sm"></span> @L["Testing…"]
                                }
                                else
                                {
                                    <i class="bi bi-plug"></i> @L["Test"]
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<MediaServer>? servers;
    private Dictionary<int, int> counts = [];
    private int testing;
    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        servers = await ServerAdmin.ListAsync();
        counts = await ServerAdmin.StreamCountsAsync();
    }

    private async Task Test(MediaServer s)
    {
        testing = s.Id;
        var r = await ServerAdmin.TestAndSyncAsync(s.Id);
        testing = 0;
        message = $"{s.Name}: {r.Message}";
        isError = !r.Ok;
    }
}
