@page "/tickets"
@layout Layout.WatchLayout
@attribute [AllowAnonymous]
@inject PaywallService Paywall
@inject ViewerAccounts Viewers

@* "My tickets": viewers sign in with a code mailed to the address they paid with and see every stream they have a ticket for.
   With ?embed={slug} it is the sign-in popup of an embedded player: it hands the ticket for that stream back and closes. *@

<AppPageTitle Text="@L["My tickets"]" />

@if (email is null)
{
    <div class="mx-auto my-4" style="max-width: 28rem">
        <div class="text-center mb-4">
            <div class="viewer-icon mb-3"><i class="bi bi-ticket-perforated"></i></div>
            <h1 class="h3 mb-1">@L["My tickets"]</h1>
            <p class="text-secondary mb-0">@L["Sign in to see all streams you have a ticket for."]</p>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-body p-4">
                @if (!Viewers.CanSignIn)
                {
                    <div class="d-flex gap-2 small text-secondary">
                        <i class="bi bi-info-circle"></i>
                        <span>@L["Signing in by email is not available here. Use the link or the ticket code you received after payment."]</span>
                    </div>
                }
                else if (Step == "code" && !string.IsNullOrEmpty(Email))
                {
                    <h2 class="h5">@L["Check your email"]</h2>
                    <p class="small text-secondary">@L["If {0} has tickets, we have just sent a 6-digit code to it. The code works for 15 minutes.", Email]</p>
                    @if (Error == "code")
                    {
                        <div class="alert alert-danger small py-2 d-flex gap-2"><i class="bi bi-exclamation-octagon"></i> @L["That code is not right or has expired. Try again or request a new code."]</div>
                    }
                    else if (Error == "limit")
                    {
                        <div class="alert alert-warning small py-2 d-flex gap-2"><i class="bi bi-hourglass-split"></i> @L["Too many codes requested. Use the last code you received, or try again in an hour."]</div>
                    }
                    <form method="post" action="tickets/verify" data-enhance="false">
                        <AntiforgeryToken />
                        <input type="hidden" name="email" value="@Email" />
                        <input type="hidden" name="embed" value="@Embed" />
                        <label class="form-label small" for="code">@L["Sign-in code"]</label>
                        <input id="code" name="code" class="form-control form-control-lg text-center otp-input mb-3" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required autofocus placeholder="000000" />
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-box-arrow-in-right"></i> @L["Sign in"]</button>
                    </form>
                    <div class="text-center mt-3 small"><a href="@($"tickets{EmbedQuery}")">@L["Use a different email address"]</a></div>
                }
                else
                {
                    @if (Error == "email")
                    {
                        <div class="alert alert-danger small py-2 d-flex gap-2"><i class="bi bi-exclamation-octagon"></i> @L["Enter a valid email address."]</div>
                    }
                    <form method="post" action="tickets/send-code" data-enhance="false">
                        <AntiforgeryToken />
                        <input type="hidden" name="embed" value="@Embed" />
                        <label class="form-label small" for="email">@L["Email address you paid with"]</label>
                        <input id="email" name="email" type="email" class="form-control form-control-lg mb-3" autocomplete="email" required autofocus placeholder="@L["you@example.com"]" />
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-envelope"></i> @L["Email me a sign-in code"]</button>
                    </form>
                    <p class="small text-secondary text-center mt-3 mb-0">@L["No password needed: you get a code by email."]</p>
                }
            </div>
        </div>

        <RedeemCard Error="@CodeError" />
    </div>
}
else
{
    @if (handoffToken is not null)
    {
        <div class="card shadow-sm mx-auto my-5 text-center" style="max-width: 28rem">
            <div class="card-body p-4">
                <i class="bi bi-check-circle text-success d-block mb-2" style="font-size: 2.5rem"></i>
                <p class="mb-0">@L["Signed in. The player starts now; you can close this window."]</p>
            </div>
        </div>
        <script>
            (function () {
                try {
                    window.opener?.postMessage({ type: "mediamtx-ticket", slug: @((MarkupString)System.Text.Json.JsonSerializer.Serialize(Embed)), token: @((MarkupString)System.Text.Json.JsonSerializer.Serialize(handoffToken)) }, location.origin);
                } catch { /* the opener is gone */ }
                setTimeout(() => window.close(), 800);
            })();
        </script>
    }
    else
    {
        <div class="page-header">
            <div>
                <h1><i class="bi bi-ticket-perforated text-primary"></i> @L["My tickets"]</h1>
                <p class="page-subtitle">@L["Signed in as {0}", email]</p>
            </div>
            <div class="page-actions">
                <form method="post" action="tickets/sign-out" data-enhance="false">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-right"></i> @L["Sign out"]</button>
                </form>
            </div>
        </div>

        @if (embedStream is not null)
        {
            <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
                <i class="bi bi-exclamation-triangle"></i>
                <span class="me-auto">@L["You don't have a valid ticket for {0} yet.", embedStream.DisplayName]</span>
                <a class="btn btn-sm btn-primary" href="watch/@embedStream.WatchSlug" data-enhance-nav="false"><i class="bi bi-ticket-perforated"></i> @L["Buy a ticket"]</a>
            </div>
        }

        @if (valid.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-ticket-perforated"></i>
                <p class="mb-0">@L["You have no valid tickets right now."]</p>
            </div>
        }
        else
        {
            <div class="row g-3 mb-4">
                @foreach (var o in valid)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100 shadow-sm ticket-card">
                            <div class="card-body d-flex flex-column p-4">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                    <h2 class="h5 mb-0">@o.Stream!.DisplayName</h2>
                                    <span class="badge bg-success-subtle text-success-emphasis badge-dot">@L["Valid"]</span>
                                </div>
                                <div class="small text-secondary mb-3">@o.OfferName</div>
                                <dl class="small mb-3">
                                    <dt class="text-secondary fw-normal">@L["Valid until"]</dt>
                                    <dd>@o.AccessExpiresAt!.Value.ToLocalTime().ToString("f")</dd>
                                    @if (!string.IsNullOrEmpty(o.Code))
                                    {
                                        <dt class="text-secondary fw-normal">@L["Ticket code"]</dt>
                                        <dd class="mb-0"><span class="ticket-code">@TicketCode.Display(o.Code)</span></dd>
                                    }
                                </dl>
                                <a class="btn btn-primary mt-auto" href="watch/@o.Stream.WatchSlug?t=@o.AccessToken" data-enhance-nav="false"><i class="bi bi-play-fill"></i> @L["Watch"]</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (expired.Count > 0)
        {
            <h2 class="h6 text-secondary mt-4">@L["Expired"]</h2>
            <div class="list-group mb-4">
                @foreach (var o in expired)
                {
                    <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 opacity-75">
                        <div><strong>@o.Stream!.DisplayName</strong> <span class="small text-secondary">· @o.OfferName</span></div>
                        <div class="d-flex align-items-center gap-2 small text-secondary">
                            @L["Expired on {0}", o.AccessExpiresAt!.Value.ToLocalTime().ToString("d")]
                            <a class="btn btn-sm btn-outline-primary" href="watch/@o.Stream.WatchSlug" data-enhance-nav="false">@L["Buy again"]</a>
                        </div>
                    </div>
                }
            </div>
        }

        <div style="max-width: 28rem">
            <RedeemCard Error="@CodeError" />
        </div>
    }
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [SupplyParameterFromQuery] public string? Step { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Embed { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? CodeError { get; set; }

    private string? email;
    private List<TicketOrder> valid = [];
    private List<TicketOrder> expired = [];
    private string? handoffToken;
    private StreamDefinition? embedStream;

    private string EmbedQuery => string.IsNullOrEmpty(Embed) ? "" : $"?embed={Uri.EscapeDataString(Embed)}";

    protected override async Task OnInitializedAsync()
    {
        email = await ViewerAccounts.EmailAsync(HttpContext);
        if (email is null)
            return;

        if (!string.IsNullOrEmpty(Embed) && await Paywall.StreamBySlugAsync(Embed) is { } stream)
        {
            var ticket = await Paywall.ValidTicketForEmailAsync(stream.Id, email);
            if (ticket is not null)
            {
                handoffToken = ticket.AccessToken;
                return;
            }
            embedStream = stream;
        }

        var now = DateTime.UtcNow;
        var tickets = await Paywall.TicketsForEmailAsync(email);
        valid = tickets.Where(o => o.GivesAccess(now) && o.Stream is { Enabled: true }).ToList();
        expired = tickets.Where(o => !o.GivesAccess(now)).ToList();
    }
}
