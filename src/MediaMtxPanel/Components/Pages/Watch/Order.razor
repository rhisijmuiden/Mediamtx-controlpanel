@page "/watch/{Slug}/order/{Id:guid}"
@layout Layout.WatchLayout
@attribute [AllowAnonymous]
@inject PaywallService Paywall
@inject NavigationManager Nav

<AppPageTitle Text="@L["Payment"]" />

@if (order is null || order.Stream?.WatchSlug != Slug)
{
    <div class="empty-state my-5 mx-auto" style="max-width: 32rem">
        <i class="bi bi-receipt"></i>
        <h1 class="h4 text-body">@L["Order not found"]</h1>
        <a class="btn btn-outline-secondary mt-2" href="watch/@Slug"><i class="bi bi-arrow-left"></i> @L["Back to the stream"]</a>
    </div>
}
else
{
    <div class="card shadow-sm mx-auto my-4" style="max-width: 32rem">
        <div class="card-body text-center p-4 p-md-5">
            <div class="text-secondary small text-uppercase fw-semibold mb-1">@L["Payment"]</div>
            <h1 class="h4">@order.Stream.DisplayName</h1>
            <p class="text-secondary mb-4">
                <i class="bi bi-ticket-perforated me-1"></i>@order.OfferName · <strong class="text-body">@Format.Money(order.AmountCents, order.Currency)</strong>
            </p>

            @switch (order.Status)
            {
                case OrderStatus.Open when Canceled:
                    <i class="bi bi-x-circle text-secondary d-block mb-2" style="font-size: 2.5rem"></i>
                    <p>@L["You canceled the payment."]</p>
                    <a class="btn btn-primary" href="watch/@Slug" data-enhance-nav="false"><i class="bi bi-arrow-repeat"></i> @L["Try again"]</a>
                    break;
                case OrderStatus.Open:
                    <meta http-equiv="refresh" content="3" />
                    <div class="spinner-border text-primary mb-3" role="status"><span class="visually-hidden">@L["Loading…"]</span></div>
                    <p>@L["Waiting for your payment to be confirmed. This page refreshes automatically."]</p>
                    @if (order.Provider == PaymentProvider.Test)
                    {
                        <form method="post" action="watch/@Slug/order/@order.Id/simulate" data-enhance="false" class="mt-4 pt-3 border-top">
                            <AntiforgeryToken />
                            <p class="small text-secondary">@L["This is a test payment; no money will be charged."]</p>
                            <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> @L["Simulate payment"]</button>
                        </form>
                    }
                    break;
                case OrderStatus.Canceled:
                    <i class="bi bi-x-circle text-secondary d-block mb-2" style="font-size: 2.5rem"></i>
                    <p>@L["The payment was canceled."]</p>
                    <a class="btn btn-primary" href="watch/@Slug" data-enhance-nav="false"><i class="bi bi-arrow-repeat"></i> @L["Try again"]</a>
                    break;
                case OrderStatus.Expired:
                    <i class="bi bi-hourglass-bottom text-warning d-block mb-2" style="font-size: 2.5rem"></i>
                    <p>@L["The payment has expired."]</p>
                    <a class="btn btn-primary" href="watch/@Slug" data-enhance-nav="false"><i class="bi bi-arrow-repeat"></i> @L["Try again"]</a>
                    break;
                default:
                    <i class="bi bi-exclamation-octagon text-danger d-block mb-2" style="font-size: 2.5rem"></i>
                    <p>@L["The payment failed. Nothing was charged."]</p>
                    <a class="btn btn-primary" href="watch/@Slug" data-enhance-nav="false"><i class="bi bi-arrow-repeat"></i> @L["Try again"]</a>
                    break;
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] public bool Canceled { get; set; }

    private TicketOrder? order;

    protected override async Task OnInitializedAsync()
    {
        order = await Paywall.RefreshOrderAsync(Id);
        if (order is { Status: OrderStatus.Paid } && order.Stream?.WatchSlug == Slug)
            Nav.NavigateTo($"watch/{Slug}?t={order.AccessToken}");
    }
}
