@page "/watch/{Slug}/order/{Id:guid}"
@layout Layout.WatchLayout
@attribute [AllowAnonymous]
@inject PaywallService Paywall
@inject NavigationManager Nav

<PageTitle>Betaling</PageTitle>

@if (order is null || order.Stream?.WatchSlug != Slug)
{
    <div class="text-center py-5">
        <h1 class="h3">Bestelling niet gevonden</h1>
        <a href="watch/@Slug">Terug naar de stream</a>
    </div>
}
else
{
    <div class="card mx-auto" style="max-width: 32rem">
        <div class="card-body text-center py-4">
            <h1 class="h4">@order.Stream.DisplayName</h1>
            <p class="text-secondary">@order.OfferName · @Format.Money(order.AmountCents, order.Currency)</p>

            @switch (order.Status)
            {
                case OrderStatus.Open when Canceled:
                    <p>Je hebt de betaling afgebroken.</p>
                    <a class="btn btn-primary" href="watch/@Slug" data-enhance-nav="false">Opnieuw proberen</a>
                    break;
                case OrderStatus.Open:
                    <meta http-equiv="refresh" content="3" />
                    <div class="spinner-border text-primary mb-3" role="status"></div>
                    <p>We wachten op de bevestiging van je betaling. Deze pagina ververst vanzelf.</p>
                    @if (order.Provider == PaymentProvider.Test)
                    {
                        <form method="post" action="watch/@Slug/order/@order.Id/simulate" data-enhance="false">
                            <AntiforgeryToken />
                            <p class="small text-secondary">Dit is een testbetaling; er wordt geen geld afgeschreven.</p>
                            <button type="submit" class="btn btn-success">Betaling simuleren</button>
                        </form>
                    }
                    break;
                case OrderStatus.Canceled:
                    <p>De betaling is geannuleerd.</p>
                    <a class="btn btn-primary" href="watch/@Slug" data-enhance-nav="false">Opnieuw proberen</a>
                    break;
                case OrderStatus.Expired:
                    <p>De betaling is verlopen.</p>
                    <a class="btn btn-primary" href="watch/@Slug" data-enhance-nav="false">Opnieuw proberen</a>
                    break;
                default:
                    <p>De betaling is mislukt. Er is niets afgeschreven.</p>
                    <a class="btn btn-primary" href="watch/@Slug" data-enhance-nav="false">Opnieuw proberen</a>
                    break;
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] public bool Canceled { get; set; }

    private TicketOrder? order;

    protected override async Task OnInitializedAsync()
    {
        order = await Paywall.RefreshOrderAsync(Id);
        if (order is { Status: OrderStatus.Paid } && order.Stream?.WatchSlug == Slug)
            Nav.NavigateTo($"watch/{Slug}?t={order.AccessToken}");
    }
}
