@page "/watch/{Slug}"
@layout Layout.WatchLayout
@attribute [AllowAnonymous]
@using System.Text.Json
@inject PaywallService Paywall
@inject StreamEndpointBuilder Endpoints
@inject MediaMtxClientFactory Clients

<PageTitle>@(stream?.DisplayName ?? "Stream")</PageTitle>

@if (stream is null || !stream.Enabled)
{
    <div class="text-center py-5">
        <h1 class="h3">Stream not found</h1>
        <p class="text-secondary">This link doesn't work (anymore). Check the address or ask the organizer for a new link.</p>
    </div>
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
        <h1 class="mb-0 me-2">@stream.DisplayName</h1>
        @if (isLive)
        {
            <span class="badge text-bg-danger">● Live</span>
        }
        else
        {
            <span class="badge text-bg-secondary">Not live yet</span>
        }
    </div>
    @if (!string.IsNullOrEmpty(stream.Description))
    {
        <p class="text-secondary">@stream.Description</p>
    }

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger">@Error</div>
    }

    @if (player is not null)
    {
        <div class="row g-4 mt-1">
            <div class="col-lg-8">
                <div data-player-root>
                    <div class="player">
                        <video data-player="@JsonSerializer.Serialize(player, JsonOptions)" autoplay muted playsinline controls></video>
                        <span class="player-status" data-player-status>Loading player…</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary active" data-player-mode="webrtc">WebRTC</button>
                            <button type="button" class="btn btn-outline-secondary" data-player-mode="hls">HLS</button>
                        </div>
                        <span class="small text-secondary">Sound is muted until you click the player.</span>
                    </div>
                </div>
                @if (!isLive)
                {
                    <p class="mt-2 text-secondary small">The broadcast hasn't started yet. The player starts automatically once there is video.</p>
                }
            </div>
            <div class="col-lg-4">
                @if (ticket is not null)
                {
                    <div class="card">
                        <div class="card-header"><strong>Your ticket</strong></div>
                        <div class="card-body small">
                            <p class="mb-2">
                                @ticket.OfferName, valid until <strong>@ticket.AccessExpiresAt!.Value.ToLocalTime().ToString("dddd, MMMM d, h:mm tt", English)</strong>.
                            </p>
                            <p class="text-secondary">Bookmark this page; you can also use the link to watch on another device.</p>
                            <h6>Watch in VLC or on TV</h6>
                            @foreach (var e in ticketUrls)
                            {
                                <CopyField Label="@e.Protocol" Value="@e.Url" Secret="true" />
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (stream.PaywallEnabled)
    {
        @if (ticketExpired)
        {
            <div class="alert alert-warning" data-ticket-invalid>Your ticket has expired or is invalid. Buy a new ticket to keep watching.</div>
        }
        <div class="row g-3 mt-1">
            @foreach (var o in offers)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h5">@o.Name</h2>
                            <div class="fs-3 fw-semibold">@Format.Money(o.PriceCents, o.Currency)</div>
                            <div class="text-secondary small mb-2">Access @Format.Hours(o.AccessHours)</div>
                            @if (!string.IsNullOrEmpty(o.Description))
                            {
                                <p class="small">@o.Description</p>
                            }
                            <form method="post" action="watch/@stream.WatchSlug/buy" class="mt-auto" data-enhance="false">
                                <AntiforgeryToken />
                                <input type="hidden" name="offerId" value="@o.Id" />
                                <input type="email" name="email" class="form-control form-control-sm mb-2" placeholder="Email (optional, for your receipt)" />
                                <div class="d-grid gap-2">
                                    @foreach (var p in providers)
                                    {
                                        <button type="submit" name="provider" value="@p" class="btn @(p == PaymentProvider.Test ? "btn-outline-secondary" : "btn-primary")">
                                            @ProviderLabel(p)
                                        </button>
                                    }
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (offers.Count == 0 || providers.Count == 0)
        {
            <p class="text-secondary">No tickets are on sale right now.</p>
        }
        <p class="small text-secondary mt-3">
            Already bought a ticket? Open the link you received after payment, or use the same browser you paid with.
        </p>
    }
    else
    {
        <div class="alert alert-secondary mt-3">This stream is private. You need credentials from the organizer to watch.</div>
    }

    <script>
        (function () {
            const key = "mediamtx-ticket:@stream.WatchSlug";
            const url = new URL(location.href);
            const t = url.searchParams.get("t");
            try {
                if (document.querySelector("[data-ticket-invalid]")) {
                    localStorage.removeItem(key);
                } else if (t) {
                    localStorage.setItem(key, t);
                } else if (@(stream.PaywallEnabled && player is null ? "true" : "false")) {
                    const saved = localStorage.getItem(key);
                    if (saved) {
                        url.searchParams.set("t", saved);
                        location.replace(url.toString());
                    }
                }
            } catch { /* storage blocked: the ticket link still works */ }
        })();
    </script>
}

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private static readonly System.Globalization.CultureInfo English = System.Globalization.CultureInfo.GetCultureInfo("en-US");

    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "t")] public string? Token { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private StreamDefinition? stream;
    private bool isLive;
    private PlayerOptions? player;
    private TicketOrder? ticket;
    private bool ticketExpired;
    private IReadOnlyList<StreamEndpoint> ticketUrls = [];
    private List<StreamOffer> offers = [];
    private List<PaymentProvider> providers = [];

    protected override async Task OnInitializedAsync()
    {
        stream = await Paywall.StreamBySlugAsync(Slug);
        if (stream is null || !stream.Enabled)
            return;

        try
        {
            isLive = (await Clients.Create(stream.Server!).GetPathAsync(stream.Name))?.IsLive == true;
        }
        catch (Exception ex) when (ex is HttpRequestException or MediaMtxException or TaskCanceledException) { }

        if (stream.PaywallEnabled)
        {
            ticket = await Paywall.ValidTicketAsync(stream.Id, Token);
            if (ticket is not null)
            {
                player = Endpoints.Player(stream, MediaMtxPanel.Endpoints.MediaMtxAuthEndpoint.TicketUser, ticket.AccessToken);
                ticketUrls = Endpoints.Ticket(stream, ticket.AccessToken);
            }
            else
            {
                ticketExpired = !string.IsNullOrEmpty(Token);
                offers = await Paywall.OffersAsync(stream.Id, activeOnly: true);
                providers = await Paywall.ProvidersForOwnerAsync(stream.OwnerId);
            }
        }
        else if (stream.PublicRead)
        {
            player = Endpoints.Player(stream, "", "");
        }
    }

    private static string ProviderLabel(PaymentProvider p) => p switch
    {
        PaymentProvider.Mollie => "Pay with iDEAL",
        PaymentProvider.PayPal => "Pay with PayPal",
        _ => "Test payment (no real money)",
    };
}
