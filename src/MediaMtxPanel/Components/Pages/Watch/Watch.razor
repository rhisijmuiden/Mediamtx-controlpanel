@page "/watch/{Slug}"
@layout Layout.WatchLayout
@attribute [AllowAnonymous]
@using System.Text.Json
@inject PaywallService Paywall
@inject StreamEndpointBuilder Endpoints
@inject MediaMtxClientFactory Clients

<AppPageTitle Text="@(stream?.DisplayName ?? L["Stream"])" />

@if (stream is null || !stream.Enabled)
{
    <div class="empty-state my-5 mx-auto" style="max-width: 32rem">
        <i class="bi bi-camera-video-off"></i>
        <h1 class="h4 text-body">@L["Stream not found"]</h1>
        <p class="mb-0">@L["This link doesn't work (anymore). Check the address or ask the organizer for a new link."]</p>
    </div>
}
else
{
    <div class="mb-4">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
            <h1 class="mb-0 me-2">@stream.DisplayName</h1>
            @if (isLive)
            {
                <span class="badge text-bg-danger badge-dot">@L["Live"]</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary-emphasis"><i class="bi bi-hourglass-split me-1"></i>@L["Not live yet"]</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(stream.Description))
        {
            <p class="text-secondary mb-0 fs-5">@stream.Description</p>
        }
    </div>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2"><i class="bi bi-exclamation-octagon"></i> <span>@L[Error]</span></div>
    }

    @if (player is not null)
    {
        <div class="row g-4">
            <div class="@(ticket is null ? "col-12" : "col-lg-8")">
                <div data-player-root>
                    <div class="player shadow-sm">
                        <video data-player="@JsonSerializer.Serialize(player, JsonOptions)" autoplay muted playsinline controls></video>
                        <span class="player-status" data-player-status>@L["Loading player…"]</span>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                        <div class="btn-group btn-group-sm" role="group" aria-label="@L["Playback technology"]">
                            <button type="button" class="btn btn-outline-secondary active" data-player-mode="webrtc">WebRTC</button>
                            <button type="button" class="btn btn-outline-secondary" data-player-mode="hls">HLS</button>
                        </div>
                        <span class="small text-secondary"><i class="bi bi-volume-mute me-1"></i>@L["Sound is muted until you click the player."]</span>
                    </div>
                </div>
                @if (!isLive)
                {
                    <div class="alert alert-light border d-flex gap-2 small mt-3 mb-0">
                        <i class="bi bi-hourglass-split"></i>
                        <span>@L["The broadcast hasn't started yet. The player starts automatically once there is video."]</span>
                    </div>
                }
            </div>
            @if (ticket is not null)
            {
                <div class="col-lg-4">
                    <div class="card">
                        <div class="card-header"><i class="bi bi-ticket-perforated"></i> @L["Your ticket"]</div>
                        <div class="card-body small">
                            <p class="mb-2">
                                <strong>@ticket.OfferName</strong><br />
                                @L["Valid until {0}.", ticket.AccessExpiresAt!.Value.ToLocalTime().ToString("f")]
                            </p>
                            @if (!string.IsNullOrEmpty(ticket.Code))
                            {
                                <div class="border rounded-3 p-2 mb-2 bg-light d-flex justify-content-between align-items-center gap-2">
                                    <div>
                                        <div class="text-secondary" style="font-size: .75rem">@L["Ticket code"]</div>
                                        <span class="ticket-code fs-6">@TicketCode.Display(ticket.Code)</span>
                                    </div>
                                    <i class="bi bi-upc-scan text-primary fs-4"></i>
                                </div>
                                <p class="text-secondary">@L["Type this code on any device, or in the player on a website, to watch."]</p>
                            }
                            <p class="text-secondary"><i class="bi bi-bookmark me-1"></i>@L["Bookmark this page; you can also use the link to watch on another device."]</p>
                            @if (!string.IsNullOrEmpty(ticket.BuyerEmail))
                            {
                                <p class="text-secondary"><i class="bi bi-person-circle me-1"></i>@L["Find all your tickets under"] <a href="tickets">@L["My tickets"]</a>.</p>
                            }
                            <h6 class="mt-3"><i class="bi bi-tv me-1 text-primary"></i> @L["Watch in VLC or on TV"]</h6>
                            @foreach (var e in ticketUrls)
                            {
                                <CopyField Label="@L[e.Protocol]" Value="@e.Url" Secret="true" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (stream.PaywallEnabled)
    {
        @if (ticketExpired)
        {
            <div class="alert alert-warning d-flex align-items-center gap-2" data-ticket-invalid>
                <i class="bi bi-exclamation-triangle"></i> <span>@L["Your ticket has expired or is invalid. Buy a new ticket to keep watching."]</span>
            </div>
        }
        <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-ticket-perforated text-primary fs-4"></i>
            <h2 class="h5 mb-0">@L["Choose a ticket"]</h2>
        </div>
        <div class="row g-3">
            @foreach (var o in offers)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column p-4">
                            <h3 class="h5 mb-1">@o.Name</h3>
                            <div class="text-secondary small mb-3"><i class="bi bi-clock me-1"></i>@L["Access {0}", Hours(o.AccessHours)]</div>
                            <div class="display-6 fw-bold mb-3">@Format.Money(o.PriceCents, o.Currency)</div>
                            @if (!string.IsNullOrEmpty(o.Description))
                            {
                                <p class="small text-secondary">@o.Description</p>
                            }
                            <form method="post" action="watch/@stream.WatchSlug/buy" class="mt-auto" data-enhance="false">
                                <AntiforgeryToken />
                                <input type="hidden" name="offerId" value="@o.Id" />
                                <label class="form-label small visually-hidden" for="email-@o.Id">@L["Email"]</label>
                                <input type="email" id="email-@o.Id" name="email" class="form-control mb-1" required autocomplete="email" value="@viewerEmail" placeholder="@L["Your email address"]" />
                                <div class="form-text mt-0 mb-2">@L["With this address you sign in to My tickets later."]</div>
                                <div class="d-grid gap-2">
                                    @foreach (var p in providers)
                                    {
                                        <button type="submit" name="provider" value="@p" class="btn @(p == PaymentProvider.Test ? "btn-outline-secondary" : "btn-primary")">
                                            <i class="bi @ProviderIcon(p)"></i> @ProviderLabel(p)
                                        </button>
                                    }
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (offers.Count == 0 || providers.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-ticket-perforated"></i>
                @L["No tickets are on sale right now."]
            </div>
        }
        <div class="row g-3 mt-2">
            <div class="col-lg-6">
                <RedeemCard Action="@($"watch/{stream.WatchSlug}/redeem")" Error="@CodeError" />
            </div>
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <h2 class="h6 mb-1"><i class="bi bi-person-circle text-primary me-1"></i> @L["Already bought a ticket?"]</h2>
                        <p class="small text-secondary">@L["Sign in with the email address you paid with to see all your tickets."]</p>
                        <a class="btn btn-outline-primary" href="tickets"><i class="bi bi-ticket-perforated"></i> @L["My tickets"]</a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-lock"></i>
            @L["This stream is private. You need credentials from the organizer to watch."]
        </div>
    }

    <script>
        (function () {
            const key = "mediamtx-ticket:@stream.WatchSlug";
            const url = new URL(location.href);
            const t = url.searchParams.get("t");
            try {
                if (document.querySelector("[data-ticket-invalid]")) {
                    localStorage.removeItem(key);
                } else if (t) {
                    localStorage.setItem(key, t);
                } else if (@(stream.PaywallEnabled && player is null ? "true" : "false")) {
                    const saved = localStorage.getItem(key);
                    if (saved) {
                        url.searchParams.set("t", saved);
                        location.replace(url.toString());
                    }
                }
            } catch { /* storage blocked: the ticket link still works */ }
            // Opened from an embedded player (to buy a ticket): hand the ticket back to it.
            const token = @((MarkupString)System.Text.Json.JsonSerializer.Serialize(ticket?.AccessToken));
            if (token && window.name === "mx-ticket" && window.opener) {
                try {
                    window.opener.postMessage({ type: "mediamtx-ticket", slug: "@stream.WatchSlug", token }, location.origin);
                    setTimeout(() => window.close(), 1500); // the player on the website takes over
                } catch { /* opener gone: keep watching here */ }
            }
        })();
    </script>
}

@code {
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "t")] public string? Token { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? CodeError { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private StreamDefinition? stream;
    private bool isLive;
    private PlayerOptions? player;
    private TicketOrder? ticket;
    private bool ticketExpired;
    private IReadOnlyList<StreamEndpoint> ticketUrls = [];
    private List<StreamOffer> offers = [];
    private List<PaymentProvider> providers = [];
    private string? viewerEmail;

    protected override async Task OnInitializedAsync()
    {
        stream = await Paywall.StreamBySlugAsync(Slug);
        if (stream is null || !stream.Enabled)
            return;

        try
        {
            isLive = (await Clients.Create(stream.Server!).GetPathAsync(stream.Name))?.IsLive == true;
        }
        catch (Exception ex) when (ex is HttpRequestException or MediaMtxException or TaskCanceledException) { }

        if (stream.PaywallEnabled)
        {
            viewerEmail = await ViewerAccounts.EmailAsync(HttpContext);
            ticket = await Paywall.ValidTicketAsync(stream.Id, Token)
                ?? await Paywall.ValidTicketForEmailAsync(stream.Id, viewerEmail);
            if (ticket is not null)
            {
                player = Endpoints.Player(stream, MediaMtxPanel.Endpoints.MediaMtxAuthEndpoint.TicketUser, ticket.AccessToken);
                ticketUrls = Endpoints.Ticket(stream, ticket.AccessToken);
            }
            else
            {
                ticketExpired = !string.IsNullOrEmpty(Token);
                offers = await Paywall.OffersAsync(stream.Id, activeOnly: true);
                providers = await Paywall.ProvidersForOwnerAsync(stream.OwnerId);
            }
        }
        else if (stream.PublicRead)
        {
            player = Endpoints.Player(stream, "", "");
        }
    }

    private string ProviderLabel(PaymentProvider p) => p switch
    {
        PaymentProvider.Mollie => L["Pay with iDEAL"],
        PaymentProvider.PayPal => L["Pay with PayPal"],
        _ => L["Test payment (no real money)"],
    };

    private static string ProviderIcon(PaymentProvider p) => p switch
    {
        PaymentProvider.Mollie => "bi-bank",
        PaymentProvider.PayPal => "bi-paypal",
        _ => "bi-cone-striped",
    };

    private string Hours(int hours) =>
        hours % 24 == 0
            ? (hours == 24 ? L["1 day"] : L["{0} days", hours / 24])
            : (hours == 1 ? L["1 hour"] : L["{0} hours", hours]);
}
