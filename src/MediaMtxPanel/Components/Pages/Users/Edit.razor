@page "/users/{Id}"
@attribute [Authorize(Roles = Roles.Admin)]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject UserAdminService UserAdmin

<PageTitle>Edit user</PageTitle>

@if (notFound)
{
    <h1>User not found</h1>
    <a href="users">Back</a>
}
else if (input is null)
{
    <p>Loading…</p>
}
else
{
    <h1>Edit user</h1>

    @if (message is not null)
    {
        <div class="alert alert-@(isError ? "danger" : "success")">@message</div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <EditForm Model="input" OnValidSubmit="Save" FormName="edit-user">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label" for="email">Email address (login)</label>
                    <InputText id="email" class="form-control" @bind-Value="input.Email" />
                    <ValidationMessage For="() => input.Email" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="dn">Name</label>
                    <InputText id="dn" class="form-control" @bind-Value="input.DisplayName" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="role">Role</label>
                    <InputSelect id="role" class="form-select" @bind-Value="input.Role" disabled="@(Id == myId)">
                        <option value="@Roles.User">User</option>
                        <option value="@Roles.Customer">Customer</option>
                        <option value="@Roles.Admin">Administrator</option>
                    </InputSelect>
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" href="users">Back</a>
            </EditForm>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header"><strong>Reset password</strong></div>
                <div class="card-body">
                    <div class="input-group mb-2">
                        <input class="form-control font-monospace" @bind="newPassword" placeholder="New password" />
                        <button type="button" class="btn btn-outline-secondary" @onclick="GeneratePassword">Generate</button>
                    </div>
                    <button class="btn btn-warning" @onclick="ResetPassword" disabled="@string.IsNullOrWhiteSpace(newPassword)">Set password</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private EditUserInput? input;
    private string myId = "";
    private string? newPassword;
    private bool notFound;
    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        myId = StreamService.UserId((await AuthState).User) ?? "";
        var u = await UserAdmin.GetAsync(Id);
        if (u is null)
        {
            notFound = true;
            return;
        }
        input = new EditUserInput { Email = u.Email, DisplayName = u.DisplayName, Role = u.Role };
    }

    private async Task Save()
    {
        var r = await UserAdmin.UpdateAsync(Id, input!.Email.Trim(), input.DisplayName, input.Role, myId);
        Report(r, "Saved.");
    }

    private void GeneratePassword() => newPassword = CredentialGenerator.Password(14) + "a1";

    private async Task ResetPassword()
    {
        var r = await UserAdmin.ResetPasswordAsync(Id, newPassword!);
        Report(r, "Password has been set. Pass the new password on to the user.");
    }

    private void Report(Microsoft.AspNetCore.Identity.IdentityResult r, string ok)
    {
        isError = !r.Succeeded;
        message = r.Succeeded ? ok : string.Join(" ", r.Errors.Select(e => e.Description));
    }

    private class EditUserInput
    {
        [Required(ErrorMessage = "Enter an email address."), EmailAddress(ErrorMessage = "Invalid email address.")]
        public string Email { get; set; } = "";
        public string? DisplayName { get; set; }
        public string Role { get; set; } = Roles.User;
    }
}
