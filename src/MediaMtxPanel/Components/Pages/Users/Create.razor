@page "/users/new"
@attribute [Authorize(Roles = Roles.Admin)]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject UserAdminService UserAdmin
@inject NavigationManager Nav

<PageTitle>New user</PageTitle>

<h1>New user</h1>

@if (errors is not null)
{
    <div class="alert alert-danger">@errors</div>
}

<EditForm Model="input" OnValidSubmit="Save" FormName="new-user" class="col-lg-6">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label" for="email">Email address (login)</label>
        <InputText id="email" class="form-control" @bind-Value="input.Email" />
        <ValidationMessage For="() => input.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="dn">Name</label>
        <InputText id="dn" class="form-control" @bind-Value="input.DisplayName" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="role">Role</label>
        <InputSelect id="role" class="form-select" @bind-Value="input.Role">
            <option value="@Roles.User">User: manages their own streams</option>
            <option value="@Roles.Customer">Customer: sees only the customer portal with their own streams, preview and paywall</option>
            <option value="@Roles.Admin">Administrator: manages all streams and users</option>
        </InputSelect>
    </div>
    <div class="mb-3">
        <label class="form-label" for="pw">Password</label>
        <div class="input-group">
            <InputText id="pw" class="form-control font-monospace" @bind-Value="input.Password" />
            <button type="button" class="btn btn-outline-secondary" @onclick="Generate">Generate</button>
        </div>
        <div class="form-text">At least 8 characters, with an uppercase letter, a lowercase letter and a digit.</div>
        <ValidationMessage For="() => input.Password" />
    </div>
    <button type="submit" class="btn btn-primary">Create user</button>
    <a class="btn btn-outline-secondary" href="users">Cancel</a>
</EditForm>

@code {
    private readonly NewUserInput input = new();
    private string? errors;

    private void Generate() => input.Password = CredentialGenerator.Password(14) + "a1";

    private async Task Save()
    {
        var r = await UserAdmin.CreateAsync(input.Email.Trim(), input.DisplayName, input.Password, input.Role);
        if (r.Succeeded)
            Nav.NavigateTo("users");
        else
            errors = string.Join(" ", r.Errors.Select(e => e.Description));
    }

    private class NewUserInput
    {
        [Required(ErrorMessage = "Enter an email address."), EmailAddress(ErrorMessage = "Invalid email address.")]
        public string Email { get; set; } = "";
        public string? DisplayName { get; set; }
        public string Role { get; set; } = Roles.User;
        [Required(ErrorMessage = "Enter a password."), MinLength(8, ErrorMessage = "At least 8 characters.")]
        public string Password { get; set; } = "";
    }
}
