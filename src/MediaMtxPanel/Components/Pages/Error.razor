@page "/Error"
@using System.Diagnostics

<AppPageTitle Text="@L["Error"]" />

<div class="page-header">
    <div>
        <h1><i class="bi bi-exclamation-octagon text-danger"></i> @L["Something went wrong"]</h1>
        <p class="page-subtitle">@L["An error occurred while processing your request."]</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href=""><i class="bi bi-house"></i> @L["Back to the start page"]</a>
    </div>
</div>

@if (ShowRequestId)
{
    <div class="card mb-3">
        <div class="card-body d-flex flex-wrap align-items-center gap-2">
            <strong>@L["Request ID:"]</strong> <code>@RequestId</code>
            <span class="text-secondary small">@L["Mention this ID when you report the problem to an administrator."]</span>
        </div>
    </div>
}

<div class="card">
    <div class="card-header"><i class="bi bi-tools"></i> @L["Development mode"]</div>
    <div class="card-body text-secondary">
        <p>@L["Swapping to the Development environment will display more detailed information about the error that occurred."]</p>
        <p class="mb-2"><strong>@L["The Development environment shouldn't be enabled for deployed applications."]</strong> @L["It can result in displaying sensitive information from exceptions to end users."]</p>
        <p class="mb-0">@L["For local debugging, set this environment variable and restart the app:"] <code>ASPNETCORE_ENVIRONMENT=Development</code></p>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
