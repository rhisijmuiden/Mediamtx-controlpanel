@page "/streams/{Id:int}"
@attribute [Authorize(Roles = Roles.Staff)]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject StreamService Streams
@inject MediaMtxClientFactory Clients
@inject StreamEndpointBuilder Endpoints
@inject NavigationManager Nav

<PageTitle>@(stream?.DisplayName ?? "Stream")</PageTitle>

@if (notFound)
{
    <h1>Stream niet gevonden</h1>
    <a href="streams">Terug naar streams</a>
}
else if (stream is null)
{
    <p>Laden…</p>
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
        <h1 class="mb-0 me-2">@stream.DisplayName</h1>
        <StreamStateBadge Stream="stream" Live="live" />
        @if (stream.PublicRead)
        {
            <span class="badge text-bg-info">Openbaar</span>
        }
        @if (stream.Record)
        {
            <span class="badge text-bg-danger">Opname</span>
        }
    </div>
    <p class="text-secondary">
        Pad <code>@stream.Name</code> op server <strong>@stream.Server!.Name</strong>
        @if (stream.Owner is not null)
        {
            <span> · eigenaar @stream.Owner.Email</span>
        }
        @if (!string.IsNullOrEmpty(stream.Description))
        {
            <br />@stream.Description
        }
    </p>

    @if (Created)
    {
        <div class="alert alert-success">
            <strong>Stream aangemaakt.</strong> Hieronder staan de inloggegevens en alle manieren om te verbinden.
            Bewaar de wachtwoorden goed; je kunt ze hier later altijd terugvinden of opnieuw genereren.
        </div>
    }
    else if (Saved)
    {
        <div class="alert alert-success">Wijzigingen opgeslagen.</div>
    }
    @if (!string.IsNullOrEmpty(Warning))
    {
        <div class="alert alert-warning">@Warning</div>
    }
    @if (message is not null)
    {
        <div class="alert alert-@(messageIsError ? "danger" : "info") alert-dismissible">
            @message
            <button type="button" class="btn-close" @onclick="() => message = null"></button>
        </div>
    }

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="btn btn-outline-primary btn-sm" href="streams/@stream.Id/edit">Bewerken</a>
        <a class="btn btn-outline-secondary btn-sm" href="portal/streams/@stream.Id">Preview en paywall</a>
        <a class="btn btn-outline-secondary btn-sm" href="watch/@stream.WatchSlug" target="_blank" rel="noopener">Kijkpagina</a>
        <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleEnabled">@(stream.Enabled ? "Uitschakelen" : "Inschakelen")</button>
        @if (!confirmDelete)
        {
            <button class="btn btn-outline-danger btn-sm" @onclick="() => confirmDelete = true">Verwijderen</button>
        }
        else
        {
            <span class="align-self-center small">Zeker weten?</span>
            <button class="btn btn-danger btn-sm" @onclick="Delete">Ja, verwijderen</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => confirmDelete = false">Nee</button>
        }
    </div>

    <div class="row g-4">
        @if (stream.SourceType == StreamSourceType.Publisher)
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Publiceren (zenden)</strong>
                        <button class="btn btn-link btn-sm p-0" @onclick="() => Regenerate(CredentialKind.Publish)">Nieuwe gegevens</button>
                    </div>
                    <div class="card-body">
                        <CopyField Label="Gebruikersnaam" Value="@stream.PublishUser" />
                        <CopyField Label="Wachtwoord" Value="@stream.PublishPassword" Secret="true" />
                        <hr />
                        <h6>OBS Studio</h6>
                        <p class="small text-secondary mb-2">Instellingen → Stream → Dienst: <em>Aangepast…</em></p>
                        <CopyField Label="Server" Value="@obs!.Server" />
                        <CopyField Label="Streamsleutel" Value="@obs.StreamKey" Secret="true" />
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header"><strong>Bron</strong></div>
                    <div class="card-body">
                        <p class="mb-2">De server haalt deze stream @(stream.SourceOnDemand ? "op zodra er een kijker is" : "continu") op van:</p>
                        <CopyField Value="@(stream.SourceUrl ?? "")" Secret="true" />
                    </div>
                </div>
            </div>
        }

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Bekijken (ontvangen)</strong>
                    @if (!stream.PublicRead)
                    {
                        <button class="btn btn-link btn-sm p-0" @onclick="() => Regenerate(CredentialKind.Read)">Nieuwe gegevens</button>
                    }
                </div>
                <div class="card-body">
                    @if (stream.PublicRead)
                    {
                        <p class="mb-0">Deze stream is openbaar: kijkers hebben geen inloggegevens nodig.</p>
                    }
                    else
                    {
                        <CopyField Label="Gebruikersnaam" Value="@stream.ReadUser" />
                        <CopyField Label="Wachtwoord" Value="@stream.ReadPassword" Secret="true" />
                        @if (stream.SourceType == StreamSourceType.Publisher)
                        {
                            <p class="small text-secondary mb-0">De publicatiegegevens werken ook om te kijken.</p>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    @if (publish.Count > 0)
    {
        <h2 class="h4 mt-4">Endpoints om te publiceren</h2>
        <EndpointTable Items="publish" />
    }

    <h2 class="h4 mt-4">Endpoints om te bekijken</h2>
    <EndpointTable Items="read" />

    <h2 class="h4 mt-4">Voorbeelden</h2>
    <div class="row g-3">
        @if (stream.SourceType == StreamSourceType.Publisher)
        {
            <div class="col-lg-6">
                <label class="form-label small text-secondary">Een bestand publiceren met ffmpeg</label>
                <pre class="cmd">@Endpoints.FfmpegPublishExample(stream)</pre>
            </div>
        }
        <div class="col-lg-6">
            <label class="form-label small text-secondary">Bekijken met ffplay</label>
            <pre class="cmd">@Endpoints.FfplayExample(stream)</pre>
        </div>
    </div>

    <h2 class="h4 mt-4">Live status</h2>
    @if (liveError is not null)
    {
        <div class="alert alert-warning">Server @stream.Server!.Name is niet bereikbaar: @liveError</div>
    }
    else if (live is null)
    {
        <p class="text-secondary">@(stream.Enabled ? "Er is nog geen bron verbonden." : "De stream is uitgeschakeld.")</p>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-sm-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-secondary small">Status</div><div class="value">@(live.IsLive ? "Live" : "Wachten")</div></div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-secondary small">Kijkers</div><div class="value">@live.Readers.Count</div></div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-secondary small">Ontvangen</div><div class="value">@Format.Bytes(live.Received)</div></div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-secondary small">Verzonden</div><div class="value">@Format.Bytes(live.Sent)</div></div></div></div>
        </div>
        <p>
            <strong>Codecs:</strong> @(live.Codecs.Any() ? string.Join(", ", live.Codecs) : "–")
            @if ((live.OnlineTime ?? live.ReadyTime) is { } since)
            {
                <span class="ms-3"><strong>Live sinds:</strong> @since.ToLocalTime().ToString("g")</span>
            }
        </p>
        @if (live.Source is not null || live.Readers.Count > 0)
        {
        <table class="table table-sm align-middle">
            <thead><tr><th>Rol</th><th>Type</th><th>ID</th><th></th></tr></thead>
            <tbody>
                @if (live.Source is not null)
                {
                    <tr>
                        <td>Bron</td><td>@live.Source.Type</td><td class="font-monospace small">@live.Source.Id</td>
                        <td class="text-end">
                            @if (MediaMtxClient.CanKick(live.Source.Type))
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => Kick(live.Source)">Verbreken</button>
                            }
                        </td>
                    </tr>
                }
                @foreach (var r in live.Readers)
                {
                    <tr>
                        <td>Kijker</td><td>@r.Type</td><td class="font-monospace small">@r.Id</td>
                        <td class="text-end">
                            @if (MediaMtxClient.CanKick(r.Type))
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => Kick(r)">Verbreken</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
    }
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public bool Created { get; set; }
    [SupplyParameterFromQuery] public bool Saved { get; set; }
    [SupplyParameterFromQuery] public string? Warning { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private StreamDefinition? stream;
    private List<StreamEndpoint> publish = [];
    private List<StreamEndpoint> read = [];
    private ObsSettings? obs;
    private MtxPath? live;
    private string? liveError;
    private bool notFound;
    private bool confirmDelete;
    private string? message;
    private bool messageIsError;
    private readonly CancellationTokenSource cts = new();

    private MediaMtxClient Mtx => Clients.Create(stream!.Server!);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (stream is not null)
        {
            await RefreshLiveAsync();
            _ = PollAsync();
        }
    }

    private async Task LoadAsync()
    {
        var s = await Streams.GetAsync((await AuthState).User, Id);
        if (s is null)
        {
            notFound = true;
            return;
        }
        stream = s;
        publish = Endpoints.Publish(s).ToList();
        read = Endpoints.Read(s).ToList();
        obs = Endpoints.Obs(s);
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                await RefreshLiveAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshLiveAsync()
    {
        if (stream is null || !stream.Enabled || !stream.Server!.Enabled)
        {
            live = null;
            liveError = null;
            return;
        }
        try
        {
            live = await Mtx.GetPathAsync(stream.Name, cts.Token);
            liveError = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or MediaMtxException or TaskCanceledException && !cts.IsCancellationRequested)
        {
            liveError = ex.Message;
        }
    }

    private async Task ToggleEnabled()
    {
        var (s, warning) = await Streams.SetEnabledAsync((await AuthState).User, Id, !stream!.Enabled);
        if (s is null) { notFound = true; return; }
        await LoadAsync();
        await RefreshLiveAsync();
        Show(warning ?? (s.Enabled ? "Stream ingeschakeld." : "Stream uitgeschakeld; lopende verbindingen zijn verbroken."), warning is not null);
    }

    private async Task Regenerate(CredentialKind kind)
    {
        await Streams.RegenerateAsync((await AuthState).User, Id, kind);
        await LoadAsync();
        Show(kind == CredentialKind.Publish
            ? "Nieuwe publicatiegegevens aangemaakt. Bestaande verbindingen blijven actief tot ze opnieuw verbinden."
            : "Nieuwe kijkgegevens aangemaakt.", false);
    }

    private async Task Delete()
    {
        var (deleted, warning) = await Streams.DeleteAsync((await AuthState).User, Id);
        if (deleted && warning is null)
            Nav.NavigateTo("streams");
        else
            Show(warning ?? "Verwijderen is mislukt.", true);
    }

    private async Task Kick(MtxConnRef conn)
    {
        try
        {
            await Mtx.KickAsync(conn.Type, conn.Id);
            Show("Verbinding verbroken.", false);
        }
        catch (Exception ex) when (ex is HttpRequestException or MediaMtxException or NotSupportedException)
        {
            Show(ex.Message, true);
        }
        await RefreshLiveAsync();
    }

    private void Show(string text, bool isError)
    {
        message = text;
        messageIsError = isError;
    }

    public ValueTask DisposeAsync()
    {
        cts.Cancel();
        cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
