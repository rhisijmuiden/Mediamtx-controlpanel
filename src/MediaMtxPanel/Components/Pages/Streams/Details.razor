@page "/streams/{Id:int}"
@attribute [Authorize(Roles = Roles.Staff)]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject StreamService Streams
@inject MediaMtxClientFactory Clients
@inject StreamEndpointBuilder Endpoints
@inject NavigationManager Nav

<PageTitle>@(stream?.DisplayName ?? "Stream")</PageTitle>

@if (notFound)
{
    <h1>Stream not found</h1>
    <a href="streams">Back to streams</a>
}
else if (stream is null)
{
    <p>Loading…</p>
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
        <h1 class="mb-0 me-2">@stream.DisplayName</h1>
        <StreamStateBadge Stream="stream" Live="live" />
        @if (stream.PublicRead)
        {
            <span class="badge text-bg-info">Public</span>
        }
        @if (stream.Record)
        {
            <span class="badge text-bg-danger">Recording</span>
        }
    </div>
    <p class="text-secondary">
        Path <code>@stream.Name</code> on server <strong>@stream.Server!.Name</strong>
        @if (stream.Owner is not null)
        {
            <span> · owner @stream.Owner.Email</span>
        }
        @if (!string.IsNullOrEmpty(stream.Description))
        {
            <br />@stream.Description
        }
    </p>

    @if (Created)
    {
        <div class="alert alert-success">
            <strong>Stream created.</strong> Below are the credentials and all the ways to connect.
            Keep the passwords safe; you can always find them here later or regenerate them.
        </div>
    }
    else if (Saved)
    {
        <div class="alert alert-success">Changes saved.</div>
    }
    @if (!string.IsNullOrEmpty(Warning))
    {
        <div class="alert alert-warning">@Warning</div>
    }
    @if (message is not null)
    {
        <div class="alert alert-@(messageIsError ? "danger" : "info") alert-dismissible">
            @message
            <button type="button" class="btn-close" @onclick="() => message = null"></button>
        </div>
    }

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a class="btn btn-outline-primary btn-sm" href="streams/@stream.Id/edit">Edit</a>
        <a class="btn btn-outline-secondary btn-sm" href="portal/streams/@stream.Id">Preview and paywall</a>
        <a class="btn btn-outline-secondary btn-sm" href="watch/@stream.WatchSlug" target="_blank" rel="noopener">Watch page</a>
        <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleEnabled">@(stream.Enabled ? "Disable" : "Enable")</button>
        @if (!confirmDelete)
        {
            <button class="btn btn-outline-danger btn-sm" @onclick="() => confirmDelete = true">Delete</button>
        }
        else
        {
            <span class="align-self-center small">Are you sure?</span>
            <button class="btn btn-danger btn-sm" @onclick="Delete">Yes, delete</button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => confirmDelete = false">No</button>
        }
    </div>

    <div class="row g-4">
        @if (stream.SourceType == StreamSourceType.Publisher)
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>Publish (send)</strong>
                        <button class="btn btn-link btn-sm p-0" @onclick="() => Regenerate(CredentialKind.Publish)">New credentials</button>
                    </div>
                    <div class="card-body">
                        <CopyField Label="Username" Value="@stream.PublishUser" />
                        <CopyField Label="Password" Value="@stream.PublishPassword" Secret="true" />
                        <hr />
                        <h6>OBS Studio</h6>
                        <p class="small text-secondary mb-2">Settings → Stream → Service: <em>Custom…</em></p>
                        <CopyField Label="Server" Value="@obs!.Server" />
                        <CopyField Label="Stream key" Value="@obs.StreamKey" Secret="true" />
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header"><strong>Source</strong></div>
                    <div class="card-body">
                        <p class="mb-2">The server pulls this stream @(stream.SourceOnDemand ? "as soon as there is a viewer" : "continuously") from:</p>
                        <CopyField Value="@(stream.SourceUrl ?? "")" Secret="true" />
                    </div>
                </div>
            </div>
        }

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Watch (receive)</strong>
                    @if (!stream.PublicRead)
                    {
                        <button class="btn btn-link btn-sm p-0" @onclick="() => Regenerate(CredentialKind.Read)">New credentials</button>
                    }
                </div>
                <div class="card-body">
                    @if (stream.PublicRead)
                    {
                        <p class="mb-0">This stream is public: viewers don't need credentials.</p>
                    }
                    else
                    {
                        <CopyField Label="Username" Value="@stream.ReadUser" />
                        <CopyField Label="Password" Value="@stream.ReadPassword" Secret="true" />
                        @if (stream.SourceType == StreamSourceType.Publisher)
                        {
                            <p class="small text-secondary mb-0">The publish credentials also work for watching.</p>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    @if (publish.Count > 0)
    {
        <h2 class="h4 mt-4">Publish endpoints</h2>
        <EndpointTable Items="publish" />
    }

    <h2 class="h4 mt-4">Watch endpoints</h2>
    <EndpointTable Items="read" />

    <h2 class="h4 mt-4">Examples</h2>
    <div class="row g-3">
        @if (stream.SourceType == StreamSourceType.Publisher)
        {
            <div class="col-lg-6">
                <label class="form-label small text-secondary">Publish a file with ffmpeg</label>
                <pre class="cmd">@Endpoints.FfmpegPublishExample(stream)</pre>
            </div>
        }
        <div class="col-lg-6">
            <label class="form-label small text-secondary">Watch with ffplay</label>
            <pre class="cmd">@Endpoints.FfplayExample(stream)</pre>
        </div>
    </div>

    <h2 class="h4 mt-4">Live status</h2>
    @if (liveError is not null)
    {
        <div class="alert alert-warning">Server @stream.Server!.Name is unreachable: @liveError</div>
    }
    else if (live is null)
    {
        <p class="text-secondary">@(stream.Enabled ? "No source is connected yet." : "The stream is disabled.")</p>
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-sm-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-secondary small">Status</div><div class="value">@(live.IsLive ? "Live" : "Waiting")</div></div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-secondary small">Viewers</div><div class="value">@live.Readers.Count</div></div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-secondary small">Received</div><div class="value">@Format.Bytes(live.Received)</div></div></div></div>
            <div class="col-sm-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-secondary small">Sent</div><div class="value">@Format.Bytes(live.Sent)</div></div></div></div>
        </div>
        <p>
            <strong>Codecs:</strong> @(live.Codecs.Any() ? string.Join(", ", live.Codecs) : "–")
            @if ((live.OnlineTime ?? live.ReadyTime) is { } since)
            {
                <span class="ms-3"><strong>Live since:</strong> @since.ToLocalTime().ToString("g")</span>
            }
        </p>
        @if (live.Source is not null || live.Readers.Count > 0)
        {
        <table class="table table-sm align-middle">
            <thead><tr><th>Role</th><th>Type</th><th>ID</th><th></th></tr></thead>
            <tbody>
                @if (live.Source is not null)
                {
                    <tr>
                        <td>Source</td><td>@live.Source.Type</td><td class="font-monospace small">@live.Source.Id</td>
                        <td class="text-end">
                            @if (MediaMtxClient.CanKick(live.Source.Type))
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => Kick(live.Source)">Disconnect</button>
                            }
                        </td>
                    </tr>
                }
                @foreach (var r in live.Readers)
                {
                    <tr>
                        <td>Viewer</td><td>@r.Type</td><td class="font-monospace small">@r.Id</td>
                        <td class="text-end">
                            @if (MediaMtxClient.CanKick(r.Type))
                            {
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => Kick(r)">Disconnect</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        }
    }
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public bool Created { get; set; }
    [SupplyParameterFromQuery] public bool Saved { get; set; }
    [SupplyParameterFromQuery] public string? Warning { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private StreamDefinition? stream;
    private List<StreamEndpoint> publish = [];
    private List<StreamEndpoint> read = [];
    private ObsSettings? obs;
    private MtxPath? live;
    private string? liveError;
    private bool notFound;
    private bool confirmDelete;
    private string? message;
    private bool messageIsError;
    private readonly CancellationTokenSource cts = new();

    private MediaMtxClient Mtx => Clients.Create(stream!.Server!);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (stream is not null)
        {
            await RefreshLiveAsync();
            _ = PollAsync();
        }
    }

    private async Task LoadAsync()
    {
        var s = await Streams.GetAsync((await AuthState).User, Id);
        if (s is null)
        {
            notFound = true;
            return;
        }
        stream = s;
        publish = Endpoints.Publish(s).ToList();
        read = Endpoints.Read(s).ToList();
        obs = Endpoints.Obs(s);
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(cts.Token))
            {
                await RefreshLiveAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task RefreshLiveAsync()
    {
        if (stream is null || !stream.Enabled || !stream.Server!.Enabled)
        {
            live = null;
            liveError = null;
            return;
        }
        try
        {
            live = await Mtx.GetPathAsync(stream.Name, cts.Token);
            liveError = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or MediaMtxException or TaskCanceledException && !cts.IsCancellationRequested)
        {
            liveError = ex.Message;
        }
    }

    private async Task ToggleEnabled()
    {
        var (s, warning) = await Streams.SetEnabledAsync((await AuthState).User, Id, !stream!.Enabled);
        if (s is null) { notFound = true; return; }
        await LoadAsync();
        await RefreshLiveAsync();
        Show(warning ?? (s.Enabled ? "Stream enabled." : "Stream disabled; active connections have been dropped."), warning is not null);
    }

    private async Task Regenerate(CredentialKind kind)
    {
        await Streams.RegenerateAsync((await AuthState).User, Id, kind);
        await LoadAsync();
        Show(kind == CredentialKind.Publish
            ? "New publish credentials created. Existing connections stay active until they reconnect."
            : "New viewer credentials created.", false);
    }

    private async Task Delete()
    {
        var (deleted, warning) = await Streams.DeleteAsync((await AuthState).User, Id);
        if (deleted && warning is null)
            Nav.NavigateTo("streams");
        else
            Show(warning ?? "Delete failed.", true);
    }

    private async Task Kick(MtxConnRef conn)
    {
        try
        {
            await Mtx.KickAsync(conn.Type, conn.Id);
            Show("Connection dropped.", false);
        }
        catch (Exception ex) when (ex is HttpRequestException or MediaMtxException or NotSupportedException)
        {
            Show(ex.Message, true);
        }
        await RefreshLiveAsync();
    }

    private void Show(string text, bool isError)
    {
        message = text;
        messageIsError = isError;
    }

    public ValueTask DisposeAsync()
    {
        cts.Cancel();
        cts.Dispose();
        return ValueTask.CompletedTask;
    }
}
