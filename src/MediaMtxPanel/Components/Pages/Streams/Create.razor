@page "/streams/new"
@attribute [Authorize(Roles = Roles.Staff)]
@rendermode InteractiveServer
@inject StreamService Streams
@inject ServerService ServerAdmin
@inject UserAdminService UserAdmin
@inject NavigationManager Nav

<AppPageTitle Text="@L["New stream"]" />

<a class="back-link" href="streams"><i class="bi bi-arrow-left"></i> @L["Back to streams"]</a>
<div class="page-header">
    <div>
        <h1><i class="bi bi-plus-circle text-primary"></i> @L["New stream"]</h1>
        <p class="page-subtitle">@L["After creating it you will immediately see the credentials and all connection URLs."]</p>
    </div>
</div>

@if (servers is null)
{
    <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>@L["Loading…"]</p>
}
else if (servers.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-hdd-network"></i>
        <p class="mb-3">@L["There is no MediaMTX server to set up the stream on yet."]</p>
        @if (isAdmin)
        {
            <a href="servers/new" class="btn btn-primary"><i class="bi bi-plus-lg"></i> @L["Add a server first"]</a>
        }
        else
        {
            <span>@L["Ask an administrator to add a server."]</span>
        }
    </div>
}
else
{
    @if (error is not null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2"><i class="bi bi-exclamation-octagon"></i> @error</div>
    }

    <StreamForm Model="input" OnValidSubmit="Save" SubmitText="@L["Create stream"]" Busy="busy" Users="users" Servers="servers" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private readonly StreamInput input = new();
    private List<UserSummary>? users;
    private List<MediaServer>? servers;
    private bool isAdmin;
    private string? error;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        isAdmin = StreamService.IsAdmin(user);
        servers = await ServerAdmin.ListAsync(enabledOnly: true);
        if (servers.Count == 1)
            input.ServerId = servers[0].Id;
        if (isAdmin)
        {
            users = await UserAdmin.ListAsync();
            input.OwnerId = StreamService.UserId(user);
        }
    }

    private async Task Save()
    {
        error = null;
        if (await Streams.NameExistsAsync(input.ServerId, input.Name.Trim()))
        {
            error = L["A stream named '{0}' already exists on this server.", input.Name];
            return;
        }

        busy = true;
        var user = (await AuthState).User;
        var (stream, warning) = await Streams.CreateAsync(user, input);
        var url = $"streams/{stream.Id}?created=true";
        if (warning is not null)
            url += "&warning=" + Uri.EscapeDataString(warning);
        Nav.NavigateTo(url);
    }
}
