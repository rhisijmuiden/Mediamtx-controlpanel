@page "/streams/new"
@attribute [Authorize(Roles = Roles.Staff)]
@rendermode InteractiveServer
@inject StreamService Streams
@inject ServerService ServerAdmin
@inject UserAdminService UserAdmin
@inject NavigationManager Nav

<PageTitle>New stream</PageTitle>

<h1>New stream</h1>

@if (servers is null)
{
    <p>Loading…</p>
}
else if (servers.Count == 0)
{
    <div class="alert alert-warning">
        There is no MediaMTX server to set up the stream on yet.
        @if (isAdmin)
        {
            <a href="servers/new" class="alert-link">Add a server first.</a>
        }
        else
        {
            <span>Ask an administrator to add a server.</span>
        }
    </div>
}
else
{
    <p class="text-secondary">After creating it you will immediately see the credentials and all connection URLs.</p>

    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }

    <StreamForm Model="input" OnValidSubmit="Save" SubmitText="Create stream" Busy="busy" Users="users" Servers="servers" />
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private readonly StreamInput input = new();
    private List<UserSummary>? users;
    private List<MediaServer>? servers;
    private bool isAdmin;
    private string? error;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        isAdmin = StreamService.IsAdmin(user);
        servers = await ServerAdmin.ListAsync(enabledOnly: true);
        if (servers.Count == 1)
            input.ServerId = servers[0].Id;
        if (isAdmin)
        {
            users = await UserAdmin.ListAsync();
            input.OwnerId = StreamService.UserId(user);
        }
    }

    private async Task Save()
    {
        error = null;
        if (await Streams.NameExistsAsync(input.ServerId, input.Name.Trim()))
        {
            error = $"A stream named '{input.Name}' already exists on this server.";
            return;
        }

        busy = true;
        var user = (await AuthState).User;
        var (stream, warning) = await Streams.CreateAsync(user, input);
        var url = $"streams/{stream.Id}?created=true";
        if (warning is not null)
            url += "&warning=" + Uri.EscapeDataString(warning);
        Nav.NavigateTo(url);
    }
}
