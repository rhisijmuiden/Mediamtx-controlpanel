@page "/streams/{Id:int}/edit"
@attribute [Authorize(Roles = Roles.Staff)]
@rendermode InteractiveServer
@inject StreamService Streams
@inject UserAdminService UserAdmin
@inject ServerService ServerAdmin
@inject NavigationManager Nav

<AppPageTitle Text="@L["Edit stream"]" />

@if (notFound)
{
    <div class="empty-state">
        <i class="bi bi-question-circle"></i>
        <h1 class="h4">@L["Stream not found"]</h1>
        <p>@L["It may have been deleted, or you don't have access to it."]</p>
        <a class="btn btn-outline-secondary" href="streams"><i class="bi bi-arrow-left"></i> @L["Back to streams"]</a>
    </div>
}
else if (input is null)
{
    <p class="text-secondary"><span class="spinner-border spinner-border-sm me-2"></span>@L["Loading…"]</p>
}
else
{
    <a class="back-link" href="streams/@Id"><i class="bi bi-arrow-left"></i> @L["Back to the stream"]</a>
    <div class="page-header">
        <div>
            <h1><i class="bi bi-pencil-square text-primary"></i> @L["Edit stream"]</h1>
            <p class="page-subtitle">@L["Change the settings of {0}. Credentials stay the same; regenerate them on the stream page.", originalName]</p>
        </div>
    </div>
    @if (input.Name != originalName || input.ServerId != originalServerId)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2"><i class="bi bi-exclamation-triangle"></i> @L["Note: changing the path name or server changes the URLs and drops active connections."]</div>
    }
    @if (error is not null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2"><i class="bi bi-exclamation-octagon"></i> @error</div>
    }
    <StreamForm Model="input" OnValidSubmit="Save" SubmitText="@L["Save changes"]" Busy="busy" Users="users" Servers="servers" CancelHref="@($"streams/{Id}")" />
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private StreamInput? input;
    private string originalName = "";
    private int originalServerId;
    private List<MediaServer> servers = [];
    private List<UserSummary>? users;
    private bool notFound;
    private bool busy;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        var stream = await Streams.GetAsync(user, Id);
        if (stream is null)
        {
            notFound = true;
            return;
        }
        input = StreamInput.From(stream);
        originalName = stream.Name;
        originalServerId = stream.ServerId;
        // Disabled servers stay selectable for a stream that is already on one.
        servers = (await ServerAdmin.ListAsync()).Where(x => x.Enabled || x.Id == stream.ServerId).ToList();
        if (StreamService.IsAdmin(user))
            users = await UserAdmin.ListAsync();
    }

    private async Task Save()
    {
        error = null;
        if (await Streams.NameExistsAsync(input!.ServerId, input.Name.Trim(), Id))
        {
            error = L["A stream named '{0}' already exists on this server.", input.Name];
            return;
        }
        busy = true;
        var (stream, warning) = await Streams.UpdateAsync((await AuthState).User, Id, input);
        busy = false;
        if (stream is null)
        {
            notFound = true;
            return;
        }
        var url = $"streams/{Id}?saved=true";
        if (warning is not null)
            url += "&warning=" + Uri.EscapeDataString(warning);
        Nav.NavigateTo(url);
    }
}
