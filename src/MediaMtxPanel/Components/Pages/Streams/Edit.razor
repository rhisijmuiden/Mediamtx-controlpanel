@page "/streams/{Id:int}/edit"
@attribute [Authorize(Roles = Roles.Staff)]
@rendermode InteractiveServer
@inject StreamService Streams
@inject UserAdminService UserAdmin
@inject ServerService ServerAdmin
@inject NavigationManager Nav

<PageTitle>Stream bewerken</PageTitle>

@if (notFound)
{
    <h1>Stream niet gevonden</h1>
    <a href="streams">Terug naar streams</a>
}
else if (input is null)
{
    <p>Laden…</p>
}
else
{
    <h1>Stream bewerken</h1>
    @if (input.Name != originalName || input.ServerId != originalServerId)
    {
        <div class="alert alert-warning">Let op: bij het wijzigen van de padnaam of server veranderen de URL's en worden lopende verbindingen verbroken.</div>
    }
    @if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }
    <StreamForm Model="input" OnValidSubmit="Save" Busy="busy" Users="users" Servers="servers" CancelHref="@($"streams/{Id}")" />
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private StreamInput? input;
    private string originalName = "";
    private int originalServerId;
    private List<MediaServer> servers = [];
    private List<UserSummary>? users;
    private bool notFound;
    private bool busy;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        var stream = await Streams.GetAsync(user, Id);
        if (stream is null)
        {
            notFound = true;
            return;
        }
        input = StreamInput.From(stream);
        originalName = stream.Name;
        originalServerId = stream.ServerId;
        // Disabled servers stay selectable for a stream that is already on one.
        servers = (await ServerAdmin.ListAsync()).Where(x => x.Enabled || x.Id == stream.ServerId).ToList();
        if (StreamService.IsAdmin(user))
            users = await UserAdmin.ListAsync();
    }

    private async Task Save()
    {
        error = null;
        if (await Streams.NameExistsAsync(input!.ServerId, input.Name.Trim(), Id))
        {
            error = $"Op deze server bestaat al een stream met de naam '{input.Name}'.";
            return;
        }
        busy = true;
        var (stream, warning) = await Streams.UpdateAsync((await AuthState).User, Id, input);
        busy = false;
        if (stream is null)
        {
            notFound = true;
            return;
        }
        var url = $"streams/{Id}?saved=true";
        if (warning is not null)
            url += "&warning=" + Uri.EscapeDataString(warning);
        Nav.NavigateTo(url);
    }
}
