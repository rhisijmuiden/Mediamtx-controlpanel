@page "/Account/ResetPasswordConfirmation"

<AppPageTitle Text="@L["Reset password confirmation"]" />

<div class="auth-page">
    <div class="card auth-card">
        <div class="card-body p-4 p-sm-5">
            <span class="brand-logo"><i class="bi bi-broadcast"></i></span>
            <h1 class="h3 mb-1 d-flex align-items-center gap-2"><i class="bi bi-check-circle text-success"></i> @L["Password reset"]</h1>
            <p class="text-secondary mb-4" role="alert">@L["Your password has been reset. You can now log in with your new password."]</p>
            <a class="btn btn-primary" href="Account/Login"><i class="bi bi-box-arrow-in-right"></i> @L["Log in"]</a>
        </div>
    </div>
</div>
