@page "/Account/InvalidPasswordReset"

<AppPageTitle Text="@L["Invalid password reset"]" />

<div class="auth-page">
    <div class="card auth-card">
        <div class="card-body p-4 p-sm-5">
            <span class="brand-logo"><i class="bi bi-broadcast"></i></span>
            <h1 class="h3 mb-1 d-flex align-items-center gap-2"><i class="bi bi-link-45deg text-danger"></i> @L["Invalid password reset"]</h1>
            <p class="text-secondary mb-4" role="alert">@L["The password reset link is invalid."]</p>
            <a class="btn btn-outline-secondary" href="Account/Login"><i class="bi bi-arrow-left"></i> @L["Back to log in"]</a>
        </div>
    </div>
</div>
