@page "/Account/ForgotPasswordConfirmation"

<AppPageTitle Text="@L["Forgot password confirmation"]" />

<div class="auth-page">
    <div class="card auth-card">
        <div class="card-body p-4 p-sm-5">
            <span class="brand-logo"><i class="bi bi-broadcast"></i></span>
            <h1 class="h3 mb-1 d-flex align-items-center gap-2"><i class="bi bi-envelope-check text-success"></i> @L["Check your email"]</h1>
            <p class="text-secondary mb-4" role="alert">@L["Please check your email to reset your password."]</p>
            <a class="btn btn-outline-secondary" href="Account/Login"><i class="bi bi-arrow-left"></i> @L["Back to log in"]</a>
        </div>
    </div>
</div>
