@page "/Account/ExternalLogin"

@using Microsoft.AspNetCore.Identity
@using MediaMtxPanel.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject EntraSso Entra
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ExternalLogin> Logger

@* Only the callback after "Sign in with Microsoft". There is no self-registration: an account is linked
   by its e-mail address, or created when Settings → Single sign-on allows it. *@

@code {
    public const string LoginCallbackAction = "LoginCallback";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? RemoteError { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    private string? Action { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (RemoteError is not null)
        {
            Fail(L["Error from external provider: {0}", RemoteError]);
            return;
        }

        var info = await SignInManager.GetExternalLoginInfoAsync();
        if (info is null || !HttpMethods.IsGet(HttpContext.Request.Method) || Action != LoginCallbackAction)
        {
            Fail(L["Error loading external login information."]);
            return;
        }

        if (info.LoginProvider != EntraSso.Scheme || !Entra.IsActive)
        {
            Fail(L["Signing in with Microsoft is turned off."]);
            return;
        }

        var (match, email) = await Entra.PrepareAsync(UserManager, info);
        switch (match)
        {
            case EntraMatch.NoEmail:
                Fail(L["Your Microsoft account has no e-mail address the panel can use."]);
                return;
            case EntraMatch.NoAccount:
                Fail(L["There is no account for {0}. Ask an administrator to create one for you.", email ?? ""]);
                return;
            case EntraMatch.Failed:
                Fail(L["Your account could not be set up. Ask an administrator to check the log."]);
                return;
        }

        // The panel's own 2FA is skipped: multi-factor sign-in is up to Entra (Conditional Access).
        var result = await SignInManager.ExternalLoginSignInAsync(info.LoginProvider, info.ProviderKey, isPersistent: false, bypassTwoFactor: true);
        if (result.Succeeded)
        {
            Logger.LogInformation("{Email} logged in with Microsoft", email);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            Fail(L["Your account could not be set up. Ask an administrator to check the log."]);
        }
    }

    private void Fail(string message) =>
        RedirectManager.RedirectToWithStatus("Account/Login", "Error: " + message, HttpContext);
}
