@page "/Account/AccessDenied"

<AppPageTitle Text="@L["Access denied"]" />

<div class="auth-page">
    <div class="card auth-card">
        <div class="card-body p-4 p-sm-5">
            <span class="brand-logo"><i class="bi bi-broadcast"></i></span>
            <h1 class="h3 mb-1 d-flex align-items-center gap-2"><i class="bi bi-shield-x text-danger"></i> @L["Access denied"]</h1>
            <p class="text-secondary mb-4">@L["You do not have access to this resource."]</p>
            <a class="btn btn-outline-secondary" href=""><i class="bi bi-arrow-left"></i> @L["Back to the start page"]</a>
        </div>
    </div>
</div>
