@page "/Account/InvalidUser"

<AppPageTitle Text="@L["Invalid user"]" />

<div class="auth-page">
    <div class="card auth-card">
        <div class="card-body p-4 p-sm-5">
            <span class="brand-logo"><i class="bi bi-broadcast"></i></span>
            <h1 class="h3 mb-3 d-flex align-items-center gap-2"><i class="bi bi-person-x text-danger"></i> @L["Invalid user"]</h1>
            <StatusMessage />
            <a class="btn btn-outline-secondary" href="Account/Login"><i class="bi bi-arrow-left"></i> @L["Back to log in"]</a>
        </div>
    </div>
</div>
