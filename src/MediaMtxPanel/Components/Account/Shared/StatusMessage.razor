@* Shows a status message. A message starting with "Error" is shown as an error; the "Error: " prefix itself is not shown.
   The text is passed through L[...] as well, so English messages (e.g. from the status cookie) appear in the user's language. *@
@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var isError = DisplayMessage.StartsWith("Error");
    var text = DisplayMessage.StartsWith("Error: ") ? DisplayMessage["Error: ".Length..] : DisplayMessage;
    <div class="alert alert-@(isError ? "danger" : "success") d-flex align-items-start gap-2" role="alert">
        <i class="bi @(isError ? "bi-exclamation-octagon" : "bi-check-circle") mt-1"></i>
        <div>@L[text]</div>
    </div>
}

@code {
    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
