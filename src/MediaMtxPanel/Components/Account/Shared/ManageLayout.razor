        <p class="page-subtitle">@L["Change your account settings: email address, password, two-factor authentication and passkeys."]</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-3">
        <ManageNavMenu />
    </div>
    <div class="col-lg-9">
        <div class="card">
            <div class="card-body p-3 p-sm-4">
                @Body
            </div>
        </div>
    </div>
</div>
