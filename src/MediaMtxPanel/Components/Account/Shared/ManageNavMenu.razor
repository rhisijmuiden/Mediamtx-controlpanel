@using Microsoft.AspNetCore.Identity
@using MediaMtxPanel.Data

@inject SignInManager<ApplicationUser> SignInManager

<nav class="nav nav-pills flex-column gap-1">
    <NavLink class="nav-link d-flex align-items-center gap-2" href="Account/Manage" Match="NavLinkMatch.All"><i class="bi bi-person"></i> @L["Profile"]</NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2" href="Account/Manage/Email"><i class="bi bi-envelope"></i> @L["Email"]</NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2" href="Account/Manage/ChangePassword"><i class="bi bi-key"></i> @L["Password"]</NavLink>
    @if (hasExternalLogins)
    {
        <NavLink class="nav-link d-flex align-items-center gap-2" href="Account/Manage/ExternalLogins"><i class="bi bi-box-arrow-in-right"></i> @L["External logins"]</NavLink>
    }
    <NavLink class="nav-link d-flex align-items-center gap-2" href="Account/Manage/TwoFactorAuthentication"><i class="bi bi-shield-lock"></i> @L["Two-factor authentication"]</NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2" href="Account/Manage/Passkeys"><i class="bi bi-fingerprint"></i> @L["Passkeys"]</NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2" href="Account/Manage/PersonalData"><i class="bi bi-file-earmark-person"></i> @L["Personal data"]</NavLink>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
