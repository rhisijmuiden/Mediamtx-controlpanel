@* Info button at the bottom of the menu: current build and the update check. *@
@implements IDisposable
@inject UpdateChecker Updates
@inject PanelSettingsStore Settings

<button type="button" class="btn btn-sidebar" @onclick="() => { open = true; tab = InfoTab.About; }" title="@L["Version and updates"]">
    <i class="bi bi-info-circle"></i> @L["Info"]
    @if (Updates.Status.UpdateAvailable)
    {
        <span class="update-dot" title="@L["Update available"]"></span>
    }
</button>

@if (open)
{
    <div class="app-modal-backdrop" @onclick="() => open = false">
        <div class="app-modal app-modal-wide" role="dialog" aria-modal="true" aria-labelledby="info-title" @onclick:stopPropagation="true">
            <header>
                <span class="brand-logo"><i class="bi bi-broadcast"></i></span>
                <div class="flex-grow-1">
                    <h2 id="info-title">@Settings.Current.AppName</h2>
                    <div class="small text-secondary">@L["Control panel for MediaMTX"]</div>
                </div>
                <button type="button" class="btn-close" @onclick="() => open = false" aria-label="@L["Close"]"></button>
            </header>
            <nav class="app-modal-tabs" role="tablist">
                <button type="button" role="tab" class="@(tab == InfoTab.About ? "active" : null)" aria-selected="@(tab == InfoTab.About)" @onclick="() => tab = InfoTab.About">
                    <i class="bi bi-info-circle"></i> @L["About"]
                </button>
                <button type="button" role="tab" class="@(tab == InfoTab.Changelog ? "active" : null)" aria-selected="@(tab == InfoTab.Changelog)" @onclick="() => tab = InfoTab.Changelog">
                    <i class="bi bi-journal-text"></i> @L["Changelog"]
                    @if (Updates.Status.NewChanges.Count > 0)
                    {
                        <span class="badge rounded-pill text-bg-primary">@L["New"]</span>
                    }
                </button>
            </nav>
            @if (tab == InfoTab.Changelog)
            {
                <div class="body">
                    <ChangelogTimeline Upcoming="Updates.Status.NewChanges" Releases="Changelog.Bundled" Repository="@Updates.Repository" />
                </div>
            }
            else
            {
            <div class="body">
                <dl class="info-list mb-4">
                    <dt>@L["Version"]</dt>
                    <dd><strong>@BuildInfo.Version</strong></dd>
                    <dt>@L["Build"]</dt>
                    <dd>
                        @if (BuildInfo.Commit is { } commit)
                        {
                            <a href="https://github.com/@Updates.Repository/commit/@commit" target="_blank" rel="noopener"><code>@BuildInfo.ShortCommit</code></a>
                        }
                        else
                        {
                            <span class="text-secondary">@L["unknown"]</span>
                        }
                    </dd>
                    <dt>@L["Built on"]</dt>
                    <dd>@(BuildInfo.BuildDate?.ToLocalTime().ToString("g") ?? "–")</dd>
                    <dt>.NET</dt>
                    <dd>@Environment.Version</dd>
                </dl>

                <div class="d-flex align-items-center gap-2 mb-2">
                    <h3 class="h6 mb-0 me-auto">@L["Updates"]</h3>
                    <AuthorizeView Roles="@Roles.Admin">
                        <Authorized>
                            <label class="small text-secondary" for="release-channel">@L["Release channel"]</label>
                            <select id="release-channel" class="form-select form-select-sm w-auto" value="@Settings.Current.ReleaseChannel" @onchange="ChangeChannel" disabled="@Updates.Checking">
                                <option value="@ReleaseChannel.Stable">@L["Stable release"]</option>
                                <option value="@ReleaseChannel.Test">@L["Test release"]</option>
                            </select>
                        </Authorized>
                        <NotAuthorized>
                            <span class="badge text-bg-light">@ChannelName(Settings.Current.ReleaseChannel)</span>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
                @{ var s = Updates.Status; }
                @if (Updates.Checking)
                {
                    <div class="alert alert-light d-flex align-items-center gap-2 mb-2">
                        <span class="spinner-border spinner-border-sm text-primary"></span> @L["Checking for updates…"]
                    </div>
                }
                else if (s.CheckedAt is null)
                {
                    <div class="alert alert-light mb-2"><i class="bi bi-clock-history me-1"></i> @L["Not checked yet."]</div>
                }
                else if (s.Error is not null && s.Latest is null)
                {
                    <div class="alert alert-warning mb-2">
                        <i class="bi bi-exclamation-triangle me-1"></i> @L["Could not reach GitHub: {0}", s.Error]
                    </div>
                }
                else if (s.UpdateAvailable)
                {
                    <div class="alert alert-warning mb-2">
                        <div class="fw-semibold"><i class="bi bi-arrow-up-circle me-1"></i> @L["A new version is available"]</div>
                        <div class="small">
                            @if (s.CommitsBehind is > 0)
                            {
                                @L["{0} new change(s) on GitHub since this build.", s.CommitsBehind]
                            }
                            else
                            {
                                @L["Latest version: {0}", s.Latest ?? ""]
                                @if (s.Prerelease)
                                {
                                    <span class="badge text-bg-warning ms-1">@L["Test version"]</span>
                                }
                            }
                            @if (s.Url is not null)
                            {
                                <a class="ms-1" href="@s.Url" target="_blank" rel="noopener">@L["What's new"] <i class="bi bi-box-arrow-up-right"></i></a>
                            }
                        </div>
                    </div>
                    @if (s.NewChanges.Count > 0)
                    {
                        <div class="whats-new mb-2">
                            <div class="d-flex align-items-center mb-1">
                                <span class="fw-semibold me-auto"><i class="bi bi-stars me-1"></i>@L["What's new"]</span>
                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => tab = InfoTab.Changelog">@L["Full changelog"] <i class="bi bi-arrow-right"></i></button>
                            </div>
                            <ul>
                                @foreach (var item in s.NewChanges.SelectMany(r => r.Sections).SelectMany(x => x.Items).Take(5))
                                {
                                    <li>@((MarkupString)Changelog.ToHtml(item, Updates.Repository))</li>
                                }
                            </ul>
                        </div>
                    }
                    <AuthorizeView Roles="@Roles.Admin">
                        <div class="small text-secondary mb-2">
                            @L["Proxmox: run the installer with update and the container ID on the Proxmox host. Docker: pull the new code and run docker compose up -d --build."]
                        </div>
                        <pre class="cmd small mb-2">bash -c "$(curl -fsSL https://raw.githubusercontent.com/@Updates.Repository/@Updates.Branch/deploy/proxmox/create-lxc.sh)" _ update &lt;CTID&gt;</pre>
                    </AuthorizeView>
                }
                else
                {
                    <div class="alert alert-success mb-2"><i class="bi bi-check-circle me-1"></i> @L["You are running the latest version."]</div>
                }
                <div class="small text-secondary">
                    @if (s.CheckedAt is { } at)
                    {
                        <div>@L["Last checked: {0}", at.ToLocalTime().ToString("g")]</div>
                    }
                    @if (Settings.Current.AutoUpdateCheck)
                    {
                        <div>@L["The panel checks automatically every 24 hours."]</div>
                    }
                    else
                    {
                        <div>@L["The automatic check is turned off under Settings."]</div>
                    }
                </div>
            </div>
            }
            <footer>
                <a class="btn btn-outline-secondary btn-sm me-auto" href="https://github.com/@Updates.Repository" target="_blank" rel="noopener"><i class="bi bi-github"></i> GitHub</a>
                <AuthorizeView Roles="@Roles.Admin">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="CheckNow" disabled="@Updates.Checking">
                        <i class="bi bi-arrow-repeat"></i> @L["Check for updates"]
                    </button>
                </AuthorizeView>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => open = false">@L["Close"]</button>
            </footer>
        </div>
    </div>
}

@code {
    private enum InfoTab { About, Changelog }

    private bool open;
    private InfoTab tab;

    protected override void OnInitialized() => Updates.Changed += OnChanged;

    private async Task CheckNow() => await Updates.CheckAsync();

    private string ChannelName(ReleaseChannel c) => c == ReleaseChannel.Test ? L["Test release"] : L["Stable release"];

    // Admins only (the select is not shown to others). Saved right away and checked again for the new channel.
    private async Task ChangeChannel(ChangeEventArgs e)
    {
        if (!Enum.TryParse<ReleaseChannel>(e.Value?.ToString(), out var channel) || channel == Settings.Current.ReleaseChannel)
            return;
        Settings.Save(Settings.Current with { ReleaseChannel = channel });
        await Updates.CheckAsync();
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Updates.Changed -= OnChanged;
}
