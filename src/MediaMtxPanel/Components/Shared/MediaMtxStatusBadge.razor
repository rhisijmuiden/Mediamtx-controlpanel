@inject MediaMtxStatus Status

@{
    var states = Status.All.Values.ToList();
    var up = states.Count(s => s.Connected);
}
@if (states.Count == 0)
{
    <span class="badge text-bg-light border badge-dot">@L["MediaMTX: checking connection…"]</span>
}
else if (up == states.Count)
{
    <span class="badge bg-success-subtle text-success-emphasis badge-dot">@(states.Count == 1 ? L["MediaMTX server connected"] : L["All {0} MediaMTX servers connected", states.Count])</span>
}
else
{
    <a href="servers" class="badge bg-danger-subtle text-danger-emphasis badge-dot">@L["{0} of {1} MediaMTX server(s) unreachable", states.Count - up, states.Count]</a>
}
