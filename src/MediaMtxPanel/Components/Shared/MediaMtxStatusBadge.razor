@inject MediaMtxStatus Status

@{
    var states = Status.All.Values.ToList();
    var up = states.Count(s => s.Connected);
}
@if (states.Count == 0)
{
    <span class="badge text-bg-secondary">MediaMTX: checking connection…</span>
}
else if (up == states.Count)
{
    <span class="badge text-bg-success">@(states.Count == 1 ? "MediaMTX server connected" : $"All {states.Count} MediaMTX servers connected")</span>
}
else
{
    <a href="servers" class="badge text-bg-danger text-decoration-none">@(states.Count - up) of @states.Count MediaMTX server(s) unreachable</a>
}
