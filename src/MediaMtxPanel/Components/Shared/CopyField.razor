@* A read-only value with a copy button (and a show/hide toggle for secrets).
   Label and Note are shown as given: callers pass already translated text. *@
@inject IJSRuntime JS

<div class="mb-2">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label small text-secondary mb-1">@Label</label>
    }
    <div class="input-group input-group-sm">
        <input class="form-control font-monospace" type="@(Secret && !revealed ? "password" : "text")" value="@Value" readonly aria-label="@Label" />
        @if (Secret)
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="() => revealed = !revealed"
                    title="@(revealed ? L["Hide"] : L["Show"])" aria-label="@(revealed ? L["Hide"] : L["Show"])">
                <i class="bi @(revealed ? "bi-eye-slash" : "bi-eye")"></i>
            </button>
        }
        <button type="button" class="btn @(copied ? "btn-success" : "btn-outline-primary")" @onclick="Copy" title="@L["Copy to clipboard"]">
            @if (copied)
            {
                <i class="bi bi-check-lg"></i><span class="d-none d-sm-inline ms-1">@L["Copied"]</span>
            }
            else
            {
                <i class="bi bi-clipboard"></i><span class="d-none d-sm-inline ms-1">@L["Copy"]</span>
            }
        </button>
    </div>
    @if (!string.IsNullOrEmpty(Note))
    {
        <div class="form-text">@Note</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Note { get; set; }
    [Parameter] public bool Secret { get; set; }

    private bool revealed;
    private bool copied;

    private async Task Copy()
    {
        await JS.InvokeVoidAsync("panel.copy", Value);
        copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        copied = false;
    }
}
