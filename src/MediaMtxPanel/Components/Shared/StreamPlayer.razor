@implements IAsyncDisposable
@inject IJSRuntime JS
@inject StreamEndpointBuilder Endpoints

<div data-player-root>
    <div class="player">
        <video @ref="video" autoplay muted playsinline controls></video>
        <span class="player-status" data-player-status>@L["Loading player…"]</span>
    </div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
        <div class="btn-group btn-group-sm" role="group" aria-label="@L["Playback technology"]">
            <button type="button" class="btn btn-outline-secondary @(mode == "webrtc" ? "active" : "")" @onclick='() => SwitchAsync("webrtc")'>WebRTC</button>
            <button type="button" class="btn btn-outline-secondary @(mode == "hls" ? "active" : "")" @onclick='() => SwitchAsync("hls")'>HLS</button>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => SwitchAsync(mode)" title="@L["Restart the player"]"><i class="bi bi-arrow-clockwise"></i> @L["Reconnect"]</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public StreamDefinition Stream { get; set; } = default!;
    [Parameter, EditorRequired] public string User { get; set; } = "";
    [Parameter, EditorRequired] public string Pass { get; set; } = "";

    private ElementReference video;
    private string mode = "webrtc";
    private bool started;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            started = true;
            await StartAsync();
        }
    }

    private async Task SwitchAsync(string newMode)
    {
        mode = newMode;
        await StartAsync();
    }

    private Task StartAsync() =>
        JS.InvokeVoidAsync("panelPlayer.start", video, Endpoints.Player(Stream, User, Pass, mode)).AsTask();

    public async ValueTask DisposeAsync()
    {
        if (!started)
            return;
        try
        {
            await JS.InvokeVoidAsync("panelPlayer.stop", video);
        }
        catch (JSDisconnectedException) { }
    }
}
