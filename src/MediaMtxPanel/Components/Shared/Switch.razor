@* A labelled on/off switch with an optional help line. Label and Help are shown as given (already translated). *@

<div class="form-check form-switch mb-2">
    <input class="form-check-input" type="checkbox" role="switch" id="@Id" checked="@Value" @onchange="OnChange" />
    <label class="form-check-label small" for="@Id">@Label</label>
    @if (!string.IsNullOrEmpty(Help))
    {
        <div class="form-text mt-0">@Help</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Help { get; set; }
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    private Task OnChange(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value is true);
}
