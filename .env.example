# Copy to .env and fill in. All passwords: use long random values.

# Host name or IP that encoders and viewers use to reach the server.
PUBLIC_HOST=stream.example.com

# First administrator of the panel (only used when no administrator exists yet).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-Admin1

# Credentials the panel uses for the MediaMTX Control API.
MTX_API_PASSWORD=change-me-api-password

# Shared secret between MediaMTX and the panel's authentication hook.
AUTH_HOOK_SECRET=change-me-hook-secret

# Address at which remote MediaMTX servers reach the panel (only needed with more than one server).
PANEL_URL=http://stream.example.com:8080
